import std;

let mapping = {"key": 3, "other": 5};

func read(n) {
  let total = 0;
  let i = 0;
  while (i < n) {
    total = total + mapping["key"];
    i = i + 1;
  }
  return total;
}

read(1000);
read(1000);
let started = std.time.monotonic_ms();
let result = read(2000000);
let elapsed = std.time.monotonic_ms() - started;
std.io.print(result);
std.io.println("");
std.io.println("SKEIN_BENCH_MS=" + str(elapsed));
