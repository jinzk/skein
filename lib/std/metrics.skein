package metrics {
  import std;
  import {Callable} from std.traits;

  func _escape_label(text) {
    text = std.string.replace(text, "\\", "\\\\");
    text = std.string.replace(text, "\"", "\\\"");
    text = std.string.replace(text, "\n", "\\n");
    return text;
  }

  func _label_text(labels, extra_key = null, extra_value = null) {
    let parts = [];
    if (kind_of(labels) == "dict") {
      let keys = [];
      for (let key in std.dict.keys(labels)) {
        keys = std.list.append(keys, key);
      }
      keys = std.list.sort(keys);
      for (let key in keys) {
        parts = std.list.append(
          parts, key + "=\"" + _escape_label(str(labels[key])) + "\"");
      }
    }
    if (extra_key != null) {
      parts = std.list.append(
        parts, extra_key + "=\"" + _escape_label(str(extra_value)) + "\"");
    }
    if (len(parts) == 0) {
      return "";
    }
    return "{" + std.string.join(parts, ",") + "}";
  }

  func _key(name, labels) {
    return name + _label_text(labels);
  }

  func _number(value) {
    return str(float(value));
  }

  // Records are long-lived and updated in place.  Scalar fields on a ref
  // handle persist; histogram counts are replaced as whole list fields so
  // renders still produce ordinary values.
  struct _CounterRec {
    name: string;
    labels: dict;
    value: number;
  }

  struct _GaugeRec {
    name: string;
    labels: dict;
    value: number;
  }

  struct _HistRec {
    name: string;
    labels: dict;
    buckets: list;
    counts: list;
    sum: number;
    count: int;
  }

  // Operations live in private callable fields; RegistryApi is the public
  // structural contract.  Copies of a Registry share the same metric tables.
  export struct Registry {
    _counter: Callable;
    _gauge: Callable;
    _observe: Callable;
    _render: Callable;
    _reset: Callable;
  }

  proto RegistryApi {
    func counter(self, name: string, labels: dict, delta: number);
    func gauge(self, name: string, labels: dict, value: number);
    func observe(self, name: string, labels: dict, value: number, buckets: any);
    func render(self);
    func reset(self);
  }

  impl Registry {
    func counter(self, name: string, labels: dict = {}, delta: number = 1) {
      return self._counter(name, labels, delta);
    }
    func gauge(self, name: string, labels: dict, value: number) {
      return self._gauge(name, labels, value);
    }
    func observe(self, name: string, labels: dict, value: number,
                 buckets: any = null) {
      return self._observe(name, labels, value, buckets);
    }
    func render(self) {
      return self._render();
    }
    func reset(self) {
      self._reset();
    }
  }

  export func new() {
    let counters = {};
    let gauges = {};
    let histograms = {};

    let counter = func(name, labels = {}, delta = 1) {
      if (kind_of(name) != "string" || name == "") {
        fail("metrics.counter name must be a non-empty string");
      }
      let key = _key(name, labels);
      let record = std.dict.get(counters, key, null);
      if (record == null) {
        record = ref _CounterRec {
          name: name, labels: labels, value: 0
        };
        counters[key] = record;
      }
      record.value = record.value + delta;
      return record.value;
    };

    let gauge = func(name, labels, value) {
      if (kind_of(name) != "string" || name == "") {
        fail("metrics.gauge name must be a non-empty string");
      }
      let key = _key(name, labels);
      gauges[key] = ref _GaugeRec {
        name: name, labels: labels, value: value
      };
      return value;
    };

    let observe = func(name, labels, value, buckets = null) {
      if (kind_of(name) != "string" || name == "") {
        fail("metrics.observe name must be a non-empty string");
      }
      let key = _key(name, labels);
      let record = std.dict.get(histograms, key, null);
      if (record == null) {
        let chosen = buckets;
        if (chosen == null) {
          chosen = [0.005, 0.01, 0.025, 0.05, 0.1, 0.25,
                    0.5, 1.0, 2.5, 5.0, 10.0];
        }
        let counts = [];
        for (let bucket in chosen) {
          counts = std.list.append(counts, 0);
        }
        record = ref _HistRec {
          name: name,
          labels: labels,
          buckets: chosen,
          counts: counts,
          sum: 0.0,
          count: 0
        };
        histograms[key] = record;
      }
      let counts = record.counts;
      let i = 0;
      while (i < len(record.buckets)) {
        if (float(value) <= float(record.buckets[i])) {
          counts[i] = counts[i] + 1;
        }
        i = i + 1;
      }
      record.counts = counts;
      record.sum = record.sum + float(value);
      record.count = record.count + 1;
      return true;
    };

    let render = func() {
      let lines = [];
      for (let key in std.dict.keys(counters)) {
        let record = counters[key];
        lines = std.list.append(
          lines, record.name + _label_text(record.labels) + " " +
                 _number(record.value));
      }
      for (let key in std.dict.keys(gauges)) {
        let record = gauges[key];
        lines = std.list.append(
          lines, record.name + _label_text(record.labels) + " " +
                 _number(record.value));
      }
      for (let key in std.dict.keys(histograms)) {
        let record = histograms[key];
        let i = 0;
        while (i < len(record.buckets)) {
          lines = std.list.append(
            lines,
            record.name + "_bucket" +
              _label_text(record.labels, "le", record.buckets[i]) +
              " " + str(record.counts[i]));
          i = i + 1;
        }
        lines = std.list.append(
          lines,
          record.name + "_bucket" +
            _label_text(record.labels, "le", "+Inf") + " " +
            str(record.count));
        lines = std.list.append(
          lines,
          record.name + "_sum" + _label_text(record.labels) +
            " " + _number(record.sum));
        lines = std.list.append(
          lines,
          record.name + "_count" + _label_text(record.labels) +
            " " + str(record.count));
      }
      return std.string.join(lines, "\n") + "\n";
    };

    let reset = func() {
      counters = {};
      gauges = {};
      histograms = {};
      return true;
    };

    return Registry {
      _counter: counter,
      _gauge: gauge,
      _observe: observe,
      _render: render,
      _reset: reset
    };
  }
}
