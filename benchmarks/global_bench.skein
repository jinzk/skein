import std;

let total = 0;

func bump(n) {
  let i = 0;
  while (i < n) {
    total = total + 1;
    i = i + 1;
  }
  return total;
}

bump(1000);
bump(1000);
let started = std.time.monotonic_ms();
let result = bump(2000000);
let elapsed = std.time.monotonic_ms() - started;
std.io.print(result);
std.io.println("");
std.io.println("SKEIN_BENCH_MS=" + str(elapsed));
