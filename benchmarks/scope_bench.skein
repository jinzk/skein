import std;

func run(n) {
  let total = 0;
  let i = 0;
  while (i < n) {
    {
      let a = i;
      let b = a + 1;
      total = total + b;
    }
    i = i + 1;
  }
  return total;
}

run(1000);
run(1000);
let started = std.time.monotonic_ms();
let result = run(1000000);
let elapsed = std.time.monotonic_ms() - started;
std.io.print(result);
std.io.println("");
std.io.println("SKEIN_BENCH_MS=" + str(elapsed));
