import std;
include "_support.skein";

struct Box[T any] {
  value: T;
  func get(self): T {
    return self.value;
  }
}

struct Pair[A any, B any] {
  first: A;
  second: B;
}

struct Limited[T int | string] {
  value: T;
}

struct UnionLimited[T int | string] {
  value: T;
}

protocol Drawable {
  func draw(self);
}

struct DrawableImpl {
  func draw(self) { }
}

struct MarkedSet[T type int | string] {
  value: T;
}

struct MarkedHash[T type hashable] {
  value: T;
}

struct MarkedProto[T proto Drawable] {
  value: T;
}

struct MarkedCombo[T type hashable & Drawable] {
  value: T;
}

struct Node[T any] {
  value: T;
  next: Node[T]?;
}

struct Holder[T any] {
  inner: Box[T]?;
}

func unwrap_int(x: Box[int]): int {
  return x.value;
}

ts_test("generic struct inference", func() {
  let a = Box { value: 1 };
  ts_eq(a.value, 1);
  let b = Box { value: "x" };
  ts_eq(b.value, "x");
});

ts_test("generic struct annotation", func() {
  let a: Box[int] = Box { value: 2 };
  ts_eq(unwrap_int(a), 2);
  let n: int = a.get();
  ts_eq(n, 2);
});

ts_test("generic struct method return type", func() {
  let s: Box[string] = Box { value: "a" };
  let text: string = s.get();
  ts_eq(text + "b", "ab");
});

ts_test("generic struct explicit literal", func() {
  let a = Box[int] { value: 3 };
  ts_eq(a.value, 3);
  let b = Box[string] { value: "b" };
  ts_eq(b.value, "b");
});

ts_test("generic struct constraint", func() {
  let a = Limited[int] { value: 4 };
  ts_eq(a.value, 4);
  let b = Limited[string] { value: "c" };
  ts_eq(b.value, "c");
});

ts_test("generic union type argument", func() {
  let a = UnionLimited[union[int, string]] { value: 6 };
  ts_eq(a.value, 6);
  let b: UnionLimited[union[int, string]] =
      UnionLimited[union[int, string]] { value: "d" };
  ts_eq(b.value, "d");
});

ts_test("generic struct explicit markers", func() {
  let a = MarkedSet[int] { value: 5 };
  ts_eq(a.value, 5);
  let b = MarkedHash[string] { value: "h" };
  ts_eq(b.value, "h");
  let c = MarkedProto[DrawableImpl] { value: DrawableImpl {} };
  c.value.draw();
  let d = MarkedCombo[DrawableImpl] { value: DrawableImpl {} };
  d.value.draw();
});

ts_test("generic struct multiple parameters", func() {
  let p: Pair[int, string] = Pair { first: 1, second: "a" };
  ts_eq(p.first, 1);
  ts_eq(p.second, "a");
});

ts_test("generic struct recursive and nested", func() {
  let n = Node[int] { value: 1, next: null };
  let m: Node[int] = Node { value: 2, next: n };
  ts_eq(m.value, 2);
  ts_eq(m.next.value, 1);
  let h = Holder[string] { inner: Box[string] { value: "b" } };
  ts_eq(h.inner.value, "b");
});

ts_finish();
