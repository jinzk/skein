// Run the VM benchmark suite against the AST backend.
//
// Each benchmark is executed several times with SKEIN_VM=0 and SKEIN_VM=1.
// The reported number is the median wall-clock time.  In --check mode the
// script fails when the VM is unexpectedly slower than AST or exceeds a
// generous absolute time budget.

import std;

let BENCHMARKS = [
  {"name": "slot", "file": "slot_bench.skein", "limit": 1.5},
  {"name": "fib", "file": "fib_bench.skein", "limit": 1.5},
  {"name": "call", "file": "call_bench.skein", "limit": 1.5},
  {"name": "pattern", "file": "pattern_bench.skein", "limit": 1.5},
  {"name": "field", "file": "field_bench.skein", "limit": 1.5},
  {"name": "method", "file": "method_bench.skein", "limit": 1.5},
  {"name": "global", "file": "global_bench.skein", "limit": 1.5},
  {"name": "index", "file": "index_bench.skein", "limit": 1.5},
  {"name": "index_write", "file": "index_write_bench.skein", "limit": 1.5},
  {"name": "scope", "file": "scope_bench.skein", "limit": 1.5},
];

func usage_text() {
  return "usage: bench_vm.skein [--bin PATH] [--repeats N] [--check]\n"
       + "                     [--max-ratio R] [--only NAME[,NAME...]]";
}

func die(message) {
  std.io.flush(std.io.stdout);
  std.io.write_all(std.io.stderr, message + "\n");
  std.sys.exit(2);
}

func parse_args(argv) {
  let bin_path = "./build/skein";
  let repeats = 3;
  let check = false;
  let max_ratio = 0.0;
  let only = "";
  let i = 0;
  while (i < len(argv)) {
    let arg = argv[i];
    if (arg == "--bin") {
      i = i + 1;
      if (i >= len(argv)) {
        die("--bin requires a value\n" + usage_text());
      }
      bin_path = argv[i];
    } else if (arg == "--repeats") {
      i = i + 1;
      if (i >= len(argv)) {
        die("--repeats requires a value\n" + usage_text());
      }
      repeats = int(argv[i]);
    } else if (arg == "--check") {
      check = true;
    } else if (arg == "--max-ratio") {
      i = i + 1;
      if (i >= len(argv)) {
        die("--max-ratio requires a value\n" + usage_text());
      }
      max_ratio = float(argv[i]);
    } else if (arg == "--only") {
      i = i + 1;
      if (i >= len(argv)) {
        die("--only requires a value\n" + usage_text());
      }
      only = argv[i];
    } else if (arg == "--help" || arg == "-h") {
      println(usage_text());
      std.sys.exit(0);
    } else {
      die("unknown argument: " + arg + "\n" + usage_text());
    }
    i = i + 1;
  }
  if (repeats < 1) {
    die("--repeats must be positive");
  }
  return {
    "bin": bin_path,
    "repeats": repeats,
    "check": check,
    "max_ratio": max_ratio,
    "only": only
  };
}

func selected(name, only) {
  if (only == "") {
    return true;
  }
  for part in split(only, ",") {
    if (trim(part) == name) {
      return true;
    }
  }
  return false;
}

func median(values) {
  let ordered = std.list.sort(values);
  let count = len(ordered);
  if (count == 0) {
    return 0.0;
  }
  let middle = count / 2;
  if (count % 2 == 1) {
    return float(ordered[middle]);
  }
  return (float(ordered[middle - 1]) + float(ordered[middle])) / 2.0;
}

func run_once(binary, script, vm) {
  let started = std.time.monotonic_ms();
  let child = std.process.spawn_command(binary, {
    "args": [script],
    "env": {"SKEIN_VM": vm},
    "stderr": "inherit"
  });
  std.io.read_all(child["stdout"]);
  let status = std.process.wait(child);
  let elapsed = float(std.time.monotonic_ms() - started) / 1000.0;
  std.process.close(child);
  if (status != 0) {
    die(script + " with SKEIN_VM=" + vm + " failed with status "
         + str(status));
  }
  return elapsed;
}

func measure(binary, script, vm, repeats) {
  let times = [];
  let i = 0;
  while (i < repeats) {
    times = times + [run_once(binary, script, vm)];
    i = i + 1;
  }
  return median(times);
}

func run(argv) {
  let options = parse_args(argv);
  let binary = options["bin"];
  if (std.fs.exists(binary) == 0) {
    die("missing binary: " + binary);
  }

  let script_path = std.sys.script();
  let script_dir = ".";
  if (script_path != "") {
    script_dir = std.fs.path_dirname(script_path);
  }
  let root = std.fs.path_abs(std.fs.path_normalize(
      std.fs.path_join(script_dir, "..")));

  let failures = [];
  println(format("{:<12} {:>8} {:>8} {:>8}",
                 "benchmark", "AST", "VM", "ratio"));
  for bench in BENCHMARKS {
    let name = bench["name"];
    if (selected(name, options["only"]) == false) {
      continue;
    }
    let script = std.fs.path_join(root,
                                  "benchmarks/" + bench["file"]);
    let ast = measure(binary, script, "0", options["repeats"]);
    let vm = measure(binary, script, "1", options["repeats"]);
    let ratio = 0.0;
    if (ast > 0.0) {
      ratio = vm / ast;
    }
    println(format("{:<12} {:>8.3f} {:>8.3f} {:>8.2f}",
                   name, ast, vm, ratio));

    let limit = bench["limit"];
    if (options["max_ratio"] > 0.0) {
      limit = options["max_ratio"];
    }
    if (options["check"] && ratio > limit) {
      failures = failures + [format(
          "{}: VM/AST ratio {:.2f} exceeds {:.2f}", name, ratio, limit)];
    }
    if (options["check"] && vm > 10.0) {
      failures = failures + [format(
          "{}: VM took {:.2f}s (limit 10s)", name, vm)];
    }
  }

  if (len(failures) > 0) {
    std.io.flush(std.io.stdout);
    for message in failures {
      std.io.write_all(std.io.stderr, "FAIL: " + message + "\n");
    }
    std.sys.exit(1);
  }
  if (options["check"]) {
    println("vm benchmark regression check passed");
  }
}

run(std.sys.args());
