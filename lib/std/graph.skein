package graph {
  import std;

  export struct Edge {
    from: int;
    to: int;
    tag: string;
    weight: any;
  }

  export struct Graph {
    nodes: dict;
    edges: dict;
    next_node: int;
    next_edge: int;
  }

  export func new() {
    return Graph { nodes: {}, edges: {}, next_node: 1, next_edge: 1 };
  }

  export func add_node(g, value) {
    let id = g.next_node;
    g.nodes[id] = value;
    g.next_node = id + 1;
    return { "graph": g, "id": id };
  }

  export func remove_node(g, id) {
    g.nodes = std.dict.delete(g.nodes, id);

    let remove = [];
    for (let eid, edge in g.edges) {
      if (edge.from == id || edge.to == id) {
        remove = std.list.append(remove, eid);
      }
    }
    for (let eid in remove) {
      g.edges = std.dict.delete(g.edges, eid);
    }
    return g;
  }

  export func has_node(g, id) {
    return std.dict.has(g.nodes, id) != 0;
  }

  export func get_node(g, id) {
    return std.dict.get(g.nodes, id);
  }

  export func set_node(g, id, value) {
    if (!has_node(g, id)) {
      fail("graph node not found: " + str(id));
    }
    g.nodes[id] = value;
    return g;
  }

  export func node_count(g) {
    return std.dict.len(g.nodes);
  }

  export func edge_count(g) {
    return std.dict.len(g.edges);
  }

  export func node_ids(g) {
    return std.dict.keys(g.nodes);
  }

  export func nodes(g) {
    return std.dict.values(g.nodes);
  }

  export func add_edge(g, from, to, ...rest) {
    if (!has_node(g, from) || !has_node(g, to)) {
      fail("graph edge endpoints must exist");
    }

    let tag = "";
    if (len(rest) > 0 && rest[0] != null) {
      tag = rest[0];
    }

    let weight = 1;
    if (len(rest) > 1 && rest[1] != null) {
      weight = rest[1];
    }
    if (kind_of(weight) != "int" && kind_of(weight) != "float") {
      fail("graph edge weight must be a number");
    }
    if (weight != weight || weight < 0) {
      fail("graph edge weight must be non-negative");
    }

    let id = g.next_edge;
    g.edges[id] = Edge {
      from: from,
      to: to,
      tag: tag,
      weight: weight
    };
    g.next_edge = id + 1;
    return { "graph": g, "id": id };
  }

  export func remove_edge(g, id) {
    g.edges = std.dict.delete(g.edges, id);
    return g;
  }

  export func edges(g) {
    let out = [];
    for (let eid, edge in g.edges) {
      out = std.list.append(out, {
        "id": eid,
        "from": edge.from,
        "to": edge.to,
        "tag": edge.tag,
        "weight": edge.weight
      });
    }
    return out;
  }

  export func neighbors(g, id, ...rest) {
    let filter = null;
    if (len(rest) > 0) {
      filter = rest[0];
    }

    let out = [];
    for (let eid, edge in g.edges) {
      if (edge.from != id) {
        continue;
      }
      if (filter != null && edge.tag != filter) {
        continue;
      }
      out = std.list.append(out, edge.to);
    }
    return out;
  }

  export func bfs(g, start) {
    let order = [];
    if (!has_node(g, start)) {
      return order;
    }

    let queue = [start];
    let seen = {};
    seen[start] = true;
    let head = 0;

    while (head < len(queue)) {
      let id = queue[head];
      head = head + 1;
      order = std.list.append(order, id);

      for (let next in neighbors(g, id)) {
        if (!std.dict.has(seen, next)) {
          seen[next] = true;
          queue = std.list.append(queue, next);
        }
      }
    }
    return order;
  }

  export func dfs(g, start) {
    let order = [];
    if (!has_node(g, start)) {
      return order;
    }

    let stack = [start];
    let seen = {};

    while (len(stack) > 0) {
      let n = len(stack);
      let id = stack[n - 1];
      stack = std.list.slice(stack, 0, n - 1);

      if (std.dict.has(seen, id)) {
        continue;
      }
      seen[id] = true;
      order = std.list.append(order, id);

      let nexts = neighbors(g, id);
      let i = len(nexts) - 1;
      while (i >= 0) {
        if (!std.dict.has(seen, nexts[i])) {
          stack = std.list.append(stack, nexts[i]);
        }
        i = i - 1;
      }
    }
    return order;
  }

  export func topo_sort(g) {
    let indeg = {};
    for (let id in std.dict.keys(g.nodes)) {
      indeg[id] = 0;
    }
    for (let eid, edge in g.edges) {
      indeg[edge.to] = indeg[edge.to] + 1;
    }

    let queue = [];
    for (let id in std.dict.keys(indeg)) {
      if (indeg[id] == 0) {
        queue = std.list.append(queue, id);
      }
    }

    let order = [];
    let head = 0;
    while (head < len(queue)) {
      let id = queue[head];
      head = head + 1;
      order = std.list.append(order, id);

      for (let next in neighbors(g, id)) {
        indeg[next] = indeg[next] - 1;
        if (indeg[next] == 0) {
          queue = std.list.append(queue, next);
        }
      }
    }

    if (len(order) != len(g.nodes)) {
      return { "ok": false, "error": "cycle" };
    }
    return { "ok": true, "order": order };
  }

  export func has_cycle(g) {
    return !topo_sort(g)["ok"];
  }

  export func path(g, from, to) {
    if (!has_node(g, from) || !has_node(g, to)) {
      return { "ok": false, "error": "node not found" };
    }
    if (from == to) {
      return { "ok": true, "path": [from] };
    }

    let queue = [from];
    let seen = {};
    let parent = {};
    seen[from] = true;
    let head = 0;

    while (head < len(queue)) {
      let id = queue[head];
      head = head + 1;

      for (let next in neighbors(g, id)) {
        if (std.dict.has(seen, next)) {
          continue;
        }
        seen[next] = true;
        parent[next] = id;
        if (next == to) {
          let out = [to];
          let current = to;
          while (current != from) {
            current = parent[current];
            out = std.list.append(out, current);
          }
          return { "ok": true, "path": std.list.reverse(out) };
        }
        queue = std.list.append(queue, next);
      }
    }

    return { "ok": false, "error": "not found" };
  }

  export func shortest_path(g, from, to, ...rest) {
    if (!has_node(g, from) || !has_node(g, to)) {
      return { "ok": false, "error": "node not found" };
    }

    let weight_fn = null;
    if (len(rest) > 0 && rest[0] != null) {
      weight_fn = rest[0];
      if (kind_of(weight_fn) != "function" &&
          kind_of(weight_fn) != "builtin") {
        fail("graph weight must be callable");
      }
    }

    let dist = {};
    let prev = {};
    let visited = {};
    dist[from] = 0;

    while (true) {
      let best = null;
      let best_dist = 0;
      for (let id in std.dict.keys(g.nodes)) {
        if (std.dict.has(visited, id) || !std.dict.has(dist, id)) {
          continue;
        }
        let d = dist[id];
        if (best == null || d < best_dist) {
          best = id;
          best_dist = d;
        }
      }
      if (best == null) {
        break;
      }
      if (best == to) {
        break;
      }
      visited[best] = true;

      for (let eid, edge in g.edges) {
        if (edge.from != best) {
          continue;
        }
        let info = {
          "id": eid,
          "from": edge.from,
          "to": edge.to,
          "tag": edge.tag,
          "weight": edge.weight
        };
        let weight = edge.weight;
        if (weight_fn != null) {
          weight = weight_fn(info);
        }
        if (kind_of(weight) != "int" && kind_of(weight) != "float") {
          return { "ok": false, "error": "edge weight must be a number" };
        }
        if (weight != weight || weight < 0) {
          return { "ok": false, "error": "negative edge weight" };
        }

        let candidate = best_dist + weight;
        if (!std.dict.has(dist, edge.to) || candidate < dist[edge.to]) {
          dist[edge.to] = candidate;
          prev[edge.to] = best;
        }
      }
    }

    if (!std.dict.has(dist, to)) {
      return { "ok": false, "error": "not found" };
    }

    let path = [to];
    let current = to;
    while (current != from) {
      current = prev[current];
      path = std.list.append(path, current);
    }
    return {
      "ok": true,
      "path": std.list.reverse(path),
      "cost": dist[to]
    };
  }

  export func components(g) {
    let seen = {};
    let out = [];

    for (let start in std.dict.keys(g.nodes)) {
      if (std.dict.has(seen, start)) {
        continue;
      }
      let component = [];
      let queue = [start];
      let head = 0;
      seen[start] = true;

      while (head < len(queue)) {
        let id = queue[head];
        head = head + 1;
        component = std.list.append(component, id);

        for (let eid, edge in g.edges) {
          let next = null;
          if (edge.from == id) {
            next = edge.to;
          } else {
            if (edge.to == id) {
              next = edge.from;
            }
          }
          if (next != null && !std.dict.has(seen, next)) {
            seen[next] = true;
            queue = std.list.append(queue, next);
          }
        }
      }
      out = std.list.append(out, component);
    }
    return out;
  }

  export func reverse(g) {
    let out = Graph {
      nodes: g.nodes,
      edges: {},
      next_node: g.next_node,
      next_edge: g.next_edge
    };
    for (let eid, edge in g.edges) {
      out.edges[eid] = Edge {
        from: edge.to,
        to: edge.from,
        tag: edge.tag,
        weight: edge.weight
      };
    }
    return out;
  }

  export func subgraph(g, ids) {
    if (kind_of(ids) != "list") {
      fail("graph.subgraph ids must be a list");
    }

    let keep = {};
    for (let id in ids) {
      if (has_node(g, id)) {
        keep[id] = true;
      }
    }

    let out = Graph {
      nodes: {},
      edges: {},
      next_node: g.next_node,
      next_edge: g.next_edge
    };
    for (let id in std.dict.keys(g.nodes)) {
      if (std.dict.has(keep, id)) {
        out.nodes[id] = g.nodes[id];
      }
    }
    for (let eid, edge in g.edges) {
      if (std.dict.has(keep, edge.from) && std.dict.has(keep, edge.to)) {
        out.edges[eid] = edge;
      }
    }
    return out;
  }

  export func to_dot(g) {
    let out = "digraph G {\n";
    for (let id in std.dict.keys(g.nodes)) {
      out = out + "  n" + str(id) + ";\n";
    }
    for (let eid, edge in g.edges) {
      out = out + "  n" + str(edge.from) + " -> n" + str(edge.to);
      if (edge.tag != "") {
        out = out + " [label=\"" + edge.tag + "\"]";
      }
      out = out + ";\n";
    }
    out = out + "}\n";
    return out;
  }
}
