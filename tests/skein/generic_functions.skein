import std;
include "_support.skein";

func identity[T any](x: T): T {
  return x;
}

func choose[T any, U any](a: T, b: U): T {
  return a;
}

func apply[T any, U any](x: T, f: (T) -> U): U {
  return f(x);
}

func limited[T int | string](x: T): T {
  return x;
}

func marked_type[T type int | string](x: T): T {
  return x;
}

func marked_hash[T type hashable](x: T): T {
  return x;
}

ts_test("generic identity", func() {
  ts_eq(identity(1), 1);
  ts_eq(identity("a"), "a");
  ts_eq(identity(true), true);
});

ts_test("generic multiple type parameters", func() {
  ts_eq(choose(1, "x"), 1);
  ts_eq(choose("x", 1), "x");
});

ts_test("generic callback", func() {
  ts_eq(apply(2, func(x) { return x * 3; }), 6);
  ts_eq(apply("a", func(x) { return x + "b"; }), "ab");
});

ts_test("generic explicit type arguments", func() {
  ts_eq(identity[int](1), 1);
  ts_eq(identity[string]("a"), "a");
  ts_eq(choose[int, string](1, "x"), 1);
});

ts_test("generic function constraints", func() {
  ts_eq(limited(1), 1);
  ts_eq(limited("a"), "a");
  ts_eq(limited[string]("b"), "b");
});

ts_test("generic function explicit markers", func() {
  ts_eq(marked_type(1), 1);
  ts_eq(marked_type("a"), "a");
  ts_eq(marked_hash(1), 1);
  ts_eq(marked_hash[string]("a"), "a");
});

ts_test("generic function value", func() {
  let g = identity[string];
  ts_eq(g("a"), "a");
  let h = choose[int, string];
  ts_eq(h(1, "b"), 1);
  ts_eq(apply(2, identity[int]), 2);
});

ts_finish();
