import std;
include "_support.skein";

ts_test("iter macro list", func() {
  let xs: list[int] = [1, 2, 3];
  let out = [];
  for x in iter!(xs) {
    out = std.list.append(out, x);
  }
  ts_eq(out, [1, 2, 3]);
});

ts_test("iter macro dict entries", func() {
  let d: dict[string, int] = {"a": 1, "b": 2};
  let out = [];
  for (k, v) in iter!(d) {
    out = std.list.append(out, k + "=" + str(v));
  }
  ts_eq(out, ["a=1", "b=2"]);
});

ts_test("iter macro canonical path", func() {
  let xs: list[int] = [4, 5];
  ts_eq(std.iter.collect(std.utils.iter!(xs)), [4, 5]);
});

ts_test("iter macro let form equivalence", func() {
  let xs: list[int] = [1, 2, 3];
  let without_let = [];
  for x in iter!(xs) {
    without_let = std.list.append(without_let, x);
  }
  let with_let = [];
  for (let x in iter!(xs)) {
    with_let = std.list.append(with_let, x);
  }
  ts_eq(without_let, with_let);
  ts_eq(with_let, [1, 2, 3]);
});

ts_test("iter macro let form equivalence dict", func() {
  let d: dict[string, int] = {"a": 1, "b": 2};
  let without_let = [];
  for k, v in iter!(d) {
    without_let = std.list.append(without_let, k + "=" + str(v));
  }
  let with_let = [];
  for (let k, v in iter!(d)) {
    with_let = std.list.append(with_let, k + "=" + str(v));
  }
  ts_eq(without_let, with_let);
  ts_eq(with_let, ["a=1", "b=2"]);
});

ts_test("iter macro let form scoping", func() {
  let x = 99;
  for x in iter!([1, 2]) { }
  ts_eq(x, 99);
  for (let x in iter!([1, 2])) { }
  ts_eq(x, 99);
});

ts_test("iter macro other builtin iterables", func() {
  let chars = std.iter.collect(iter!("ab"));
  ts_eq(len(chars), 2);
  ts_eq(str(chars[0]), "a");
  ts_eq(str(chars[1]), "b");
  ts_eq(std.iter.collect(iter!(std.bytes.from_hex("00ff"))), [0, 255]);

  func gen(): generator[int] {
    yield 1;
    yield 2;
  }
  ts_eq(std.iter.collect(iter!(gen())), [1, 2]);
  ts_eq(std.iter.collect(iter!((1, 2))), [1, 2]);
});

ts_finish();
