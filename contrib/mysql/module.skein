module mysql {
  export package api.mysql as client;

  export api.mysql.VERSION as VERSION;
  export api.mysql.connect as connect;
  export api.mysql.wrap_result as wrap_result;
  export api.mysql.as_int as as_int;
  export api.mysql.as_float as as_float;
  export api.mysql.as_bool as as_bool;
  export api.mysql.library_version as library_version;

  native {
    sources "native/mysql_module.cpp";
    libs "mysqlclient";
    output "skein_mysql_module";
  }
}
