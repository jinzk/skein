import std;

func add(a, b) {
  return a + b;
}

func run(n) {
  let total = 0;
  let i = 0;
  while (i < n) {
    total = add(total, 1);
    i = i + 1;
  }
  return total;
}

run(1000);
run(1000);
let started = std.time.monotonic_ms();
let result = run(2000000);
let elapsed = std.time.monotonic_ms() - started;
print(result);
println("");
println("SKEIN_BENCH_MS=" + str(elapsed));
