package graph {
  import std;

  export struct Edge {
    from: int;
    to: int;
    tag: string;
    weight: any;
  }

  export struct Graph {
    nodes: dict;
    edges: dict;
    next_node: int;
    next_edge: int;
  }

  export func new() {
    return Graph { nodes: {}, edges: {}, next_node: 1, next_edge: 1 };
  }

  export func add_node(g, value) {
    let id = g.next_node;
    g.nodes[id] = value;
    g.next_node = id + 1;
    return { "graph": g, "id": id };
  }

  // Batched node insertion: one COW clone instead of one per node.
  export func add_nodes(g, values) {
    if (kind_of(values) != "list") {
      fail("graph.add_nodes values must be a list");
    }
    let ids = std.deque.new();
    for (let value in values) {
      let id = g.next_node;
      g.nodes[id] = value;
      g.next_node = id + 1;
      ids = std.deque.push_back(ids, id);
    }
    return { "graph": g, "ids": std.deque.to_list(ids) };
  }

  export func remove_node(g, id) {
    g.nodes = std.dict.delete(g.nodes, id);

    let remove = std.deque.new();
    for (let eid, edge in g.edges) {
      if (edge.from == id || edge.to == id) {
        remove = std.deque.push_back(remove, eid);
      }
    }
    for (let eid in std.deque.to_list(remove)) {
      g.edges = std.dict.delete(g.edges, eid);
    }
    return g;
  }

  export func has_node(g, id) {
    return std.dict.has(g.nodes, id) != 0;
  }

  export func get_node(g, id) {
    return std.dict.get(g.nodes, id);
  }

  export func set_node(g, id, value) {
    if (!has_node(g, id)) {
      fail("graph node not found: " + str(id));
    }
    g.nodes[id] = value;
    return g;
  }

  export func node_count(g) {
    return std.dict.len(g.nodes);
  }

  export func edge_count(g) {
    return std.dict.len(g.edges);
  }

  export func node_ids(g) {
    return std.dict.keys(g.nodes);
  }

  export func nodes(g) {
    return std.dict.values(g.nodes);
  }

  export func add_edge(g, from, to, tag = "", weight = 1) {
    if (!has_node(g, from) || !has_node(g, to)) {
      fail("graph edge endpoints must exist");
    }

    if (kind_of(weight) != "int" && kind_of(weight) != "float") {
      fail("graph edge weight must be a number");
    }
    if (weight != weight || weight < 0) {
      fail("graph edge weight must be non-negative");
    }

    let id = g.next_edge;
    g.edges[id] = Edge {
      from: from,
      to: to,
      tag: tag,
      weight: weight
    };
    g.next_edge = id + 1;
    return { "graph": g, "id": id };
  }

  // Batched edge insertion: one COW clone instead of one per edge.
  // Each edge is [from, to], [from, to, tag] or [from, to, tag, weight].
  export func add_edges(g, edges) {
    if (kind_of(edges) != "list") {
      fail("graph.add_edges edges must be a list");
    }
    for (let spec in edges) {
      if (kind_of(spec) != "list" || len(spec) < 2 || len(spec) > 4) {
        fail("graph.add_edges edge must be [from, to[, tag[, weight]]]");
      }
      let from = spec[0];
      let to = spec[1];
      if (!std.dict.has(g.nodes, from) || !std.dict.has(g.nodes, to)) {
        fail("graph edge endpoints must exist");
      }

      let tag = "";
      if (len(spec) > 2 && spec[2] != null) {
        tag = spec[2];
      }
      let weight = 1;
      if (len(spec) > 3 && spec[3] != null) {
        weight = spec[3];
      }
      if (kind_of(weight) != "int" && kind_of(weight) != "float") {
        fail("graph edge weight must be a number");
      }
      if (weight != weight || weight < 0) {
        fail("graph edge weight must be non-negative");
      }

      let id = g.next_edge;
      g.edges[id] = Edge {
        from: from,
        to: to,
        tag: tag,
        weight: weight
      };
      g.next_edge = id + 1;
    }
    return g;
  }

  // Convenience batch builder: nodes 1..count with value = id.
  export func from_edges(count, edges) {
    if (kind_of(count) != "int" || count < 0) {
      fail("graph.from_edges count must be a non-negative int");
    }
    let values = std.deque.new();
    let i = 0;
    while (i < count) {
      values = std.deque.push_back(values, i + 1);
      i = i + 1;
    }
    let g = add_nodes(new(), std.deque.to_list(values))["graph"];
    return add_edges(g, edges);
  }

  export func remove_edge(g, id) {
    g.edges = std.dict.delete(g.edges, id);
    return g;
  }

  export func edges(g) {
    let out = std.deque.new();
    for (let eid, edge in g.edges) {
      out = std.deque.push_back(out, {
        "id": eid,
        "from": edge.from,
        "to": edge.to,
        "tag": edge.tag,
        "weight": edge.weight
      });
    }
    return std.deque.to_list(out);
  }

  export func neighbors(g, id, tag = null) {
    let out = std.deque.new();
    for (let eid, edge in g.edges) {
      if (edge.from != id) {
        continue;
      }
      if (tag != null && edge.tag != tag) {
        continue;
      }
      out = std.deque.push_back(out, edge.to);
    }
    return std.deque.to_list(out);
  }

  // Directed adjacency: node id -> list of target ids, in edge insertion order.
  func _adjacency(g) {
    let buckets = {};
    for (let eid, edge in g.edges) {
      let bucket = std.dict.get(buckets, edge.from);
      if (bucket == null) {
        bucket = std.deque.new();
      }
      buckets[edge.from] = std.deque.push_back(bucket, edge.to);
    }
    let out = {};
    for (let id, bucket in buckets) {
      out[id] = std.deque.to_list(bucket);
    }
    return out;
  }

  // Undirected adjacency: both endpoints are connected.
  func _undirected_adjacency(g) {
    let buckets = {};
    for (let eid, edge in g.edges) {
      let forward = std.dict.get(buckets, edge.from);
      if (forward == null) {
        forward = std.deque.new();
      }
      buckets[edge.from] = std.deque.push_back(forward, edge.to);
      if (edge.from == edge.to) {
        continue;
      }
      let backward = std.dict.get(buckets, edge.to);
      if (backward == null) {
        backward = std.deque.new();
      }
      buckets[edge.to] = std.deque.push_back(backward, edge.from);
    }
    let out = {};
    for (let id, bucket in buckets) {
      out[id] = std.deque.to_list(bucket);
    }
    return out;
  }

  // Weighted adjacency: node id -> list of edge dicts, ready for weight_fn.
  func _weighted_adjacency(g) {
    let buckets = {};
    for (let eid, edge in g.edges) {
      let bucket = std.dict.get(buckets, edge.from);
      if (bucket == null) {
        bucket = std.deque.new();
      }
      buckets[edge.from] = std.deque.push_back(bucket, {
        "id": eid,
        "from": edge.from,
        "to": edge.to,
        "tag": edge.tag,
        "weight": edge.weight
      });
    }
    let out = {};
    for (let id, bucket in buckets) {
      out[id] = std.deque.to_list(bucket);
    }
    return out;
  }

  export func bfs(g, start) {
    let order = std.deque.new();
    if (!has_node(g, start)) {
      return std.deque.to_list(order);
    }

    let adj = _adjacency(g);
    let queue = std.deque.from_list([start]);
    let seen = {};
    seen[start] = true;

    while (std.deque.size(queue) > 0) {
      let popped = std.deque.pop_front(queue);
      let id = popped["value"];
      queue = popped["deque"];
      order = std.deque.push_back(order, id);

      let nexts = std.dict.get(adj, id);
      if (nexts == null) {
        continue;
      }
      for (let next in nexts) {
        if (!std.dict.has(seen, next)) {
          seen[next] = true;
          queue = std.deque.push_back(queue, next);
        }
      }
    }
    return std.deque.to_list(order);
  }

  export func dfs(g, start) {
    let order = std.deque.new();
    if (!has_node(g, start)) {
      return std.deque.to_list(order);
    }

    let adj = _adjacency(g);
    let stack = std.deque.from_list([start]);
    let seen = {};

    while (std.deque.size(stack) > 0) {
      let popped = std.deque.pop_back(stack);
      let id = popped["value"];
      stack = popped["deque"];

      if (std.dict.has(seen, id)) {
        continue;
      }
      seen[id] = true;
      order = std.deque.push_back(order, id);

      let nexts = std.dict.get(adj, id);
      if (nexts == null) {
        continue;
      }
      let i = len(nexts) - 1;
      while (i >= 0) {
        if (!std.dict.has(seen, nexts[i])) {
          stack = std.deque.push_back(stack, nexts[i]);
        }
        i = i - 1;
      }
    }
    return std.deque.to_list(order);
  }

  export func topo_sort(g) {
    let indeg = {};
    for (let id in std.dict.keys(g.nodes)) {
      indeg[id] = 0;
    }
    for (let eid, edge in g.edges) {
      indeg[edge.to] = indeg[edge.to] + 1;
    }

    let queue = std.deque.new();
    for (let id in std.dict.keys(indeg)) {
      if (indeg[id] == 0) {
        queue = std.deque.push_back(queue, id);
      }
    }

    let adj = _adjacency(g);
    let order = std.deque.new();
    while (std.deque.size(queue) > 0) {
      let popped = std.deque.pop_front(queue);
      let id = popped["value"];
      queue = popped["deque"];
      order = std.deque.push_back(order, id);

      let nexts = std.dict.get(adj, id);
      if (nexts == null) {
        continue;
      }
      for (let next in nexts) {
        indeg[next] = indeg[next] - 1;
        if (indeg[next] == 0) {
          queue = std.deque.push_back(queue, next);
        }
      }
    }

    if (std.deque.size(order) != len(g.nodes)) {
      return { "ok": false, "error": "cycle" };
    }
    return { "ok": true, "order": std.deque.to_list(order) };
  }

  export func has_cycle(g) {
    return !topo_sort(g)["ok"];
  }

  export func path(g, from, to) {
    if (!has_node(g, from) || !has_node(g, to)) {
      return { "ok": false, "error": "node not found" };
    }
    if (from == to) {
      return { "ok": true, "path": [from] };
    }

    let adj = _adjacency(g);
    let queue = std.deque.from_list([from]);
    let seen = {};
    let parent = {};
    seen[from] = true;

    while (std.deque.size(queue) > 0) {
      let popped = std.deque.pop_front(queue);
      let id = popped["value"];
      queue = popped["deque"];

      let nexts = std.dict.get(adj, id);
      if (nexts == null) {
        continue;
      }
      for (let next in nexts) {
        if (std.dict.has(seen, next)) {
          continue;
        }
        seen[next] = true;
        parent[next] = id;
        if (next == to) {
          let out = std.deque.from_list([to]);
          let current = to;
          while (current != from) {
            current = parent[current];
            out = std.deque.push_front(out, current);
          }
          return { "ok": true, "path": std.deque.to_list(out) };
        }
        queue = std.deque.push_back(queue, next);
      }
    }

    return { "ok": false, "error": "not found" };
  }

  export func shortest_path(g, from, to, weight_fn = null) {
    if (!has_node(g, from) || !has_node(g, to)) {
      return { "ok": false, "error": "node not found" };
    }

    if (weight_fn != null &&
        kind_of(weight_fn) != "function" &&
        kind_of(weight_fn) != "builtin") {
      fail("graph weight must be callable");
    }

    let dist = {};
    let prev = {};
    let visited = {};
    dist[from] = 0;

    let adj = _weighted_adjacency(g);
    while (true) {
      let best = null;
      let best_dist = 0;
      for (let id in std.dict.keys(g.nodes)) {
        if (std.dict.has(visited, id) || !std.dict.has(dist, id)) {
          continue;
        }
        let d = dist[id];
        if (best == null || d < best_dist) {
          best = id;
          best_dist = d;
        }
      }
      if (best == null) {
        break;
      }
      if (best == to) {
        break;
      }
      visited[best] = true;

      let outgoing = std.dict.get(adj, best);
      if (outgoing == null) {
        continue;
      }
      for (let info in outgoing) {
        let weight = info["weight"];
        if (weight_fn != null) {
          weight = weight_fn(info);
        }
        if (kind_of(weight) != "int" && kind_of(weight) != "float") {
          return { "ok": false, "error": "edge weight must be a number" };
        }
        if (weight != weight || weight < 0) {
          return { "ok": false, "error": "negative edge weight" };
        }

        let candidate = best_dist + weight;
        if (!std.dict.has(dist, info["to"]) ||
            candidate < dist[info["to"]]) {
          dist[info["to"]] = candidate;
          prev[info["to"]] = best;
        }
      }
    }

    if (!std.dict.has(dist, to)) {
      return { "ok": false, "error": "not found" };
    }

    let path = std.deque.from_list([to]);
    let current = to;
    while (current != from) {
      current = prev[current];
      path = std.deque.push_front(path, current);
    }
    return {
      "ok": true,
      "path": std.deque.to_list(path),
      "cost": dist[to]
    };
  }

  export func components(g) {
    let seen = {};
    let out = std.deque.new();
    let adj = _undirected_adjacency(g);

    for (let start in std.dict.keys(g.nodes)) {
      if (std.dict.has(seen, start)) {
        continue;
      }
      let component = std.deque.new();
      let queue = std.deque.from_list([start]);
      seen[start] = true;

      while (std.deque.size(queue) > 0) {
        let popped = std.deque.pop_front(queue);
        let id = popped["value"];
        queue = popped["deque"];
        component = std.deque.push_back(component, id);

        let nexts = std.dict.get(adj, id);
        if (nexts == null) {
          continue;
        }
        for (let next in nexts) {
          if (!std.dict.has(seen, next)) {
            seen[next] = true;
            queue = std.deque.push_back(queue, next);
          }
        }
      }
      out = std.deque.push_back(out, std.deque.to_list(component));
    }
    return std.deque.to_list(out);
  }

  export func reverse(g) {
    let out = Graph {
      nodes: g.nodes,
      edges: {},
      next_node: g.next_node,
      next_edge: g.next_edge
    };
    for (let eid, edge in g.edges) {
      out.edges[eid] = Edge {
        from: edge.to,
        to: edge.from,
        tag: edge.tag,
        weight: edge.weight
      };
    }
    return out;
  }

  export func subgraph(g, ids) {
    if (kind_of(ids) != "list") {
      fail("graph.subgraph ids must be a list");
    }

    let keep = {};
    for (let id in ids) {
      if (has_node(g, id)) {
        keep[id] = true;
      }
    }

    let out = Graph {
      nodes: {},
      edges: {},
      next_node: g.next_node,
      next_edge: g.next_edge
    };
    for (let id in std.dict.keys(g.nodes)) {
      if (std.dict.has(keep, id)) {
        out.nodes[id] = g.nodes[id];
      }
    }
    for (let eid, edge in g.edges) {
      if (std.dict.has(keep, edge.from) && std.dict.has(keep, edge.to)) {
        out.edges[eid] = edge;
      }
    }
    return out;
  }

  export func to_dot(g) {
    let parts = std.deque.new();
    parts = std.deque.push_back(parts, "digraph G {\n");
    for (let id in std.dict.keys(g.nodes)) {
      parts = std.deque.push_back(parts, "  n" + str(id) + ";\n");
    }
    for (let eid, edge in g.edges) {
      let line = "  n" + str(edge.from) + " -> n" + str(edge.to);
      if (edge.tag != "") {
        line = line + " [label=\"" + edge.tag + "\"]";
      }
      parts = std.deque.push_back(parts, line + ";\n");
    }
    parts = std.deque.push_back(parts, "}\n");
    return std.string.join(std.deque.to_list(parts), "");
  }
}
