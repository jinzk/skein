import std;
import std.password;
include "_support.skein";

ts_test("argon2id hash and verify", func() {
  let encoded = std.password.hash("secret", {
    "memory_kib": 1024,
    "iterations": 1,
    "parallelism": 1
  });
  ts_eq(std.string.starts_with(encoded, "$argon2id$v=19$"), 1);
  ts_true(std.password.verify("secret", encoded));
  ts_false(std.password.verify("wrong", encoded));
  ts_false(std.password.verify("secret", "not-a-hash"));
});

ts_test("argon2id salts are unique", func() {
  let a = std.password.hash("secret", {"memory_kib": 1024, "iterations": 1});
  let b = std.password.hash("secret", {"memory_kib": 1024, "iterations": 1});
  ts_true(a != b);
  ts_true(std.password.verify("secret", a));
  ts_true(std.password.verify("secret", b));
});

ts_test("password rejects weak parameters", func() {
  ts_error(func() {
    std.password.hash("secret", {"memory_kib": 1, "iterations": 1});
  }, "outside safe ranges");
  ts_error(func() {
    std.password.hash("secret", {"iterations": 0});
  }, "outside safe ranges");
});

ts_finish();
