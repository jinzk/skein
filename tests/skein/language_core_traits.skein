import std;
include "_support.skein";

protocol ProtoDrawable {
  func draw(self) {
    return "default";
  }

  func area(self) -> int;
}

struct ProtoPoint {
  x: int;
}

impl ProtoPoint {
  func area(self): int {
    return self.x;
  }
}

func proto_area(value: ProtoDrawable) {
  return value.area();
}

protocol ProtoOverride {
  func label(self) {
    return "protocol";
  }
}

struct ProtoOverrideC {}

impl ProtoOverrideC {
  func label(self) {
    return "impl";
  }
}

protocol ProtoRequired {
  func base(self);

  func doubled(self) {
    return self.base() * 2;
  }
}

struct ProtoRequiredC {}

impl ProtoRequiredC {
  func base(self) {
    return 4;
  }
}

protocol ProtoInlineRequired {
  func base(self) -> int;

  func doubled(self) {
    return self.base() * 2;
  }
}

struct ProtoInlineC {
  seed: int;
  func base(self): int { return self.seed; }
  func twice(self) -> self.base() * 2;
  func doubled(self) -> self.base() * 2;
}

impl ProtoInlineC {
  func triple(self) -> self.base() * 3;
}

func proto_inline_doubled(value: ProtoInlineRequired) {
  return value.doubled();
}

protocol ProtoStructDefault {
  func struct_default(self) {
    return "struct";
  }
}

struct ProtoStructC {
  x: int;
}

protocol ProtoEnumRequired {
  func value(self) -> int;
}

enum ProtoEnumC {
  A { n: int; }
  B;
}

impl ProtoEnumC {
  func value(self): int {
    return match (self) {
      case ProtoEnumC.A { n } => n;
      case ProtoEnumC.B => 0;
    };
  }
}

func proto_value(value: ProtoEnumRequired) {
  return value.value();
}

protocol ProtoEnumDefault {
  func enum_default(self) {
    return "enum";
  }
}

struct ProtoWithS {
  with: int;
  func doubled(self) -> self.with * 2;
}

ts_test("protocol default method", func() {
  let p = ProtoPoint { x: 3 };
  ts_eq(p.draw(), "default");
  ts_eq(proto_area(p), 3);
});

ts_test("protocol default method override", func() {
  ts_eq(ProtoOverrideC {}.label(), "impl");
});

ts_test("protocol default calls required method", func() {
  ts_eq(ProtoRequiredC {}.doubled(), 8);
});

ts_test("inline struct method", func() {
  let c = ProtoInlineC { seed: 5 };
  ts_eq(c.base(), 5);
  ts_eq(c.twice(), 10);
});

ts_test("inline method and impl method coexist", func() {
  ts_eq(ProtoInlineC { seed: 5 }.triple(), 15);
});

ts_test("inline method satisfies protocol default", func() {
  let c = ProtoInlineC { seed: 4 };
  ts_eq(proto_inline_doubled(c), 8);
  ts_true(c is ProtoInlineRequired);
});

ts_test("structural struct protocol match", func() {
  ts_eq(ProtoStructC { x: 1 }.struct_default(), "struct");
  ts_true(ProtoStructC { x: 1 } is ProtoStructDefault);
});

ts_test("structural enum protocol match", func() {
  ts_eq(proto_value(ProtoEnumC.A { n: 5 }), 5);
  ts_eq(proto_value(ProtoEnumC.B), 0);
  ts_true(ProtoEnumC.B is ProtoEnumRequired);
  ts_eq(ProtoEnumC.B.enum_default(), "enum");
});

ts_test("protocol is structural", func() {
  ts_true(ProtoPoint { x: 1 } is ProtoDrawable);
  ts_false(ProtoPoint { x: 1 } is ProtoEnumRequired);
});

ts_test("with remains an identifier", func() {
  let with = 7;
  let s = ProtoWithS { with: 9 };
  ts_eq(with + s.with, 16);
  ts_eq(s.doubled(), 18);
});

struct PrivateBox {
  _value: int;
  label: string;

  func _secret(self): int { return self._value; }
  func reveal(self): int { return self._secret(); }
  func peer_value(self, other: PrivateBox): int { return other._value; }
}

ts_test("underscore members are soft private", func() {
  let box = PrivateBox { _value: 7, label: "a" };
  ts_eq(box.reveal(), 7);
  ts_eq(box.peer_value(PrivateBox { _value: 9, label: "b" }), 9);
  let field_caught = false;
  let field_result = box._value on error(e) {
    field_caught = true;
    recover null;
  };
  ts_true(field_caught);
  let method_caught = false;
  let method_result = box._secret() on error(e) {
    method_caught = true;
    recover null;
  };
  ts_true(method_caught);
});

ts_finish();
