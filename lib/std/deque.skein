package deque {
  import std;

  // Native deque module.  Keeping this file as a re-export lets scripts use
  // both `import std.deque;` and `import std; std.deque.*` without adding a
  // wrapper call to every operation.

  export let new = std.deque.new;
  export let from_list = std.deque.from_list;
  export let size = std.deque.size;
  export let push_front = std.deque.push_front;
  export let push_back = std.deque.push_back;
  export let peek_front = std.deque.peek_front;
  export let peek_back = std.deque.peek_back;
  export let pop_front = std.deque.pop_front;
  export let pop_back = std.deque.pop_back;
  export let to_list = std.deque.to_list;
}
