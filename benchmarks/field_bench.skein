import std;

struct Point {
  x: int;
  y: int;
}

func sum(n) {
  let p = Point { x: 1, y: 2 };
  let total = 0;
  let i = 0;
  while (i < n) {
    total = total + p.x + p.y;
    i = i + 1;
  }
  return total;
}

sum(1000);
sum(1000);
let started = std.time.monotonic_ms();
let result = sum(2000000);
let elapsed = std.time.monotonic_ms() - started;
std.io.print(result);
std.io.println("");
std.io.println("SKEIN_BENCH_MS=" + str(elapsed));
