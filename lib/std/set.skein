package set {
  import std;

  // Native persistent set module.  Keeping this file as a re-export lets
  // scripts use both `import std.set;` and `import std; std.set.*` without
  // adding a wrapper call to every operation.

  export let new = std.set.new;
  export let from_list = std.set.from_list;
  export let add = std.set.add;
  export let remove = std.set.remove;
  export let has = std.set.has;
  export let size = std.set.size;
  export let values = std.set.values;
  export let union = std.set.union;
  export let intersect = std.set.intersect;
  export let difference = std.set.difference;
  export let is_subset = std.set.is_subset;
}
