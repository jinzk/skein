// Shared assertions for Skein test files.
//
// Test files must import std before including this file.
// Successful runs end with a line like:
//
//   ok: 29 case(s), 0 skipped
//
// The Python harness (tests/harness.py:run_skein) requires that marker so a
// test file that exits early without running anything is reported as a
// failure instead of passing silently.

func ts_show(value) {
  if (std.type.kind_of(value) == "string") {
    return "\"" + value + "\"";
  }
  if (value == null) {
    return "null";
  }
  return str(value);
}

func ts_split_env(name) {
  let raw = std.env.get(name);
  let out = [];
  if (raw == null) {
    return out;
  }
  for (let item in std.string.split(raw, ",")) {
    let text = std.string.trim(item);
    if (text != "") {
      out = std.list.append(out, text);
    }
  }
  return out;
}

let ts_failures = [];
let ts_current = "";
let ts_total = 0;
let ts_skipped = 0;
let ts_only = std.env.get("SKEIN_TEST_CASE");
let ts_skip_exact = ts_split_env("SKEIN_TEST_SKIP");
let ts_skip_prefixes = ts_split_env("SKEIN_TEST_SKIP_PREFIX");

func ts_fail(message) {
  ts_failures = std.list.append(ts_failures, ts_current + ": " + message);
}

func ts_skip(name) {
  if (ts_only != null && ts_only != "" && name != ts_only) {
    return true;
  }
  for (let item in ts_skip_exact) {
    if (item == name) {
      return true;
    }
  }
  for (let prefix in ts_skip_prefixes) {
    if (std.string.starts_with(name, prefix)) {
      return true;
    }
  }
  return false;
}

// Run one named case. Unexpected errors are captured so the remaining cases
// still run; assertion helpers record failures without throwing.
func ts_test(name, body) {
  if (ts_skip(name)) {
    ts_skipped = ts_skipped + 1;
    return;
  }
  ts_current = name;
  ts_total = ts_total + 1;
  let result = std.result.capture(body);
  if (std.result.is_err(result)) {
    ts_fail("unexpected error: " + std.error.message(std.result.error(result)));
  }
}

func ts_eq(got, want) {
  if (got != want) {
    ts_fail("expected " + ts_show(want) + ", got " + ts_show(got));
  }
}

// Like ts_eq, but also requires the runtime kind to match (for example int
// versus float, which compare equal with ==).
func ts_same(got, want) {
  if (std.type.kind_of(got) != std.type.kind_of(want) || got != want) {
    ts_fail("expected " + ts_show(want) + ", got " + ts_show(got) +
            " [" + std.type.kind_of(want) + " vs " + std.type.kind_of(got) + "]");
  }
}

func ts_true(value) {
  if (value != true) {
    ts_fail("expected true, got " + ts_show(value));
  }
}

func ts_false(value) {
  if (value != false) {
    ts_fail("expected false, got " + ts_show(value));
  }
}

func ts_contains(text, fragment) {
  if (!std.string.contains(text, fragment)) {
    ts_fail("expected " + ts_show(text) + " to contain " + ts_show(fragment));
  }
}

// Check that thunk() raises a runtime error whose message contains fragment.
// Syntax and type-check errors happen before execution and cannot be caught
// here; those stay in the Python suite.
func ts_error(thunk, fragment) {
  let result = std.result.capture(thunk);
  if (std.result.is_ok(result)) {
    ts_fail("expected error containing " + ts_show(fragment) + ", got ok");
    return;
  }
  let message = std.error.message(std.result.error(result));
  if (!std.string.contains(message, fragment)) {
    ts_fail("expected error containing " + ts_show(fragment) +
            ", got " + ts_show(message));
  }
}

func ts_finish() {
  if (ts_only != null && ts_only != "" && ts_total == 0) {
    std.io.print("FAIL no case matched SKEIN_TEST_CASE=" + ts_only + "\n");
    std.sys.exit(1);
  }
  if (std.utils.len(ts_failures) > 0) {
    for (let failure in ts_failures) {
      std.io.print("FAIL " + failure + "\n");
    }
    std.io.print("failed: " + str(std.utils.len(ts_failures)) + " failure(s), " +
          str(ts_total) + " case(s), " + str(ts_skipped) + " skipped\n");
    std.sys.exit(1);
  }
  std.io.print("ok: " + str(ts_total) + " case(s), " + str(ts_skipped) + " skipped\n");
}
