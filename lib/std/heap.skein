package heap {
  import std;

  // Native persistent heap module.  Keeping this file as a re-export lets
  // scripts use both `import std.heap;` and `import std; std.heap.*` without
  // adding a wrapper call to every operation.

  export let new = std.heap.new;
  export let from_list = std.heap.from_list;
  export let size = std.heap.size;
  export let peek = std.heap.peek;
  export let push = std.heap.push;
  export let pop = std.heap.pop;
  export let to_list = std.heap.to_list;
}
