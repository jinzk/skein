import std;

struct Counter {
  n: int;
}

impl Counter {
  func add(self, d) {
    return self.n + d;
  }
}

func run(count) {
  let c = Counter { n: 1 };
  let total = 0;
  let i = 0;
  while (i < count) {
    total = total + c.add(1);
    i = i + 1;
  }
  return total;
}

run(1000);
run(1000);
let started = std.time.monotonic_ms();
let result = run(600000);
let elapsed = std.time.monotonic_ms() - started;
print(result);
println("");
println("SKEIN_BENCH_MS=" + str(elapsed));
