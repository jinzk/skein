import std;
import mysql;

func env(name, fallback = "") {
  return std.env.get(name, fallback);
}

let conn = mysql.connect(
  env("SKEIN_TEST_MYSQL_HOST", "127.0.0.1"),
  env("SKEIN_TEST_MYSQL_USER", "root"),
  env("SKEIN_TEST_MYSQL_PASSWORD", ""),
  env("SKEIN_TEST_MYSQL_DATABASE", "skein_test"),
  int(env("SKEIN_TEST_MYSQL_PORT", "3306")),
);

println(mysql.VERSION);
println(conn.ping());
let result = conn.query("SELECT VERSION() AS version");
println(result.rows());
result.close();
conn.close();
