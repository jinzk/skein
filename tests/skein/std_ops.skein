import std;
import {Add, Sub, Mul, Div, Mod, Equatable, Comparable} from std.ops;
include "_support.skein";

struct OpNum {
  value: int;

  func op_add(self, rhs: OpNum): OpNum {
    return OpNum { value: self.value + rhs.value };
  }
  func op_sub(self, rhs: OpNum): OpNum {
    return OpNum { value: self.value - rhs.value };
  }
  func op_mul(self, rhs: OpNum): OpNum {
    return OpNum { value: self.value * rhs.value };
  }
  func op_div(self, rhs: OpNum): OpNum {
    return OpNum { value: self.value / rhs.value };
  }
  func op_mod(self, rhs: OpNum): OpNum {
    return OpNum { value: self.value % rhs.value };
  }
  func op_eq(self, rhs: OpNum): bool {
    return self.value == rhs.value;
  }
  func op_cmp(self, rhs: OpNum): int {
    return self.value - rhs.value;
  }
}

func do_add[T Add[T, T]](a: T, b: T): T { return a.op_add(b); }
func do_sub[T Sub[T, T]](a: T, b: T): T { return a.op_sub(b); }
func do_mul[T Mul[T, T]](a: T, b: T): T { return a.op_mul(b); }
func do_div[T Div[T, T]](a: T, b: T): T { return a.op_div(b); }
func do_mod[T Mod[T, T]](a: T, b: T): T { return a.op_mod(b); }
func do_eq[T Equatable[T]](a: T, b: T): bool { return a.op_eq(b); }
func do_cmp[T Comparable[T]](a: T, b: T): int { return a.op_cmp(b); }

ts_test("std.ops structural protocols", func() {
  let a = OpNum { value: 12 };
  let b = OpNum { value: 5 };

  ts_eq(do_add(a, b).value, 17);
  ts_eq(do_sub(a, b).value, 7);
  ts_eq(do_mul(a, b).value, 60);
  ts_eq(do_div(a, b).value, 2);
  ts_eq(do_mod(a, b).value, 2);
  ts_eq(do_eq(a, OpNum { value: 12 }), true);
  ts_eq(do_cmp(a, b) > 0, true);
});

ts_test("std.ops arithmetic operators", func() {
  let a = OpNum { value: 12 };
  let b = OpNum { value: 5 };

  ts_eq((a + b).value, 17);
  ts_eq((a - b).value, 7);
  ts_eq((a * b).value, 60);
  ts_eq((a / b).value, 2);
  ts_eq((a % b).value, 2);

  // Built-in arithmetic keeps the original fast path.
  ts_eq(3 + 4, 7);
  ts_eq(7 - 3, 4);
  ts_eq(3 * 4, 12);
  ts_eq(7 / 3, 2);
  ts_eq(7 % 3, 1);
  ts_eq("a" + "b", "ab");
});

ts_test("std.ops equality operators", func() {
  let a = OpNum { value: 12 };
  let b = OpNum { value: 5 };
  let same = OpNum { value: 12 };

  ts_eq(a == b, false);
  ts_eq(a == same, true);
  ts_eq(a != b, true);
  ts_eq(a <> b, true);
  ts_eq(same != b, true);
  ts_eq(b != b, false);

  // Built-in equality keeps the original fast path, including NaN.
  ts_eq(3 == 3, true);
  ts_eq(3 != 4, true);
  ts_eq("a" == "a", true);
  let nan = float("nan");
  ts_eq(nan == nan, false);
  ts_eq(nan != nan, true);
});

ts_test("std.ops ordering operators", func() {
  let a = OpNum { value: 12 };
  let b = OpNum { value: 5 };
  let same = OpNum { value: 12 };

  ts_eq(a < b, false);
  ts_eq(a <= b, false);
  ts_eq(a > b, true);
  ts_eq(a >= b, true);
  ts_eq(b < a, true);
  ts_eq(b <= a, true);
  ts_eq(same <= a, true);
  ts_eq(same >= a, true);

  // Built-in ordering keeps the original NaN semantics.
  ts_eq(3 < 4, true);
  ts_eq(4 <= 3, false);
  ts_eq("a" < "b", true);
  let nan = float("nan");
  ts_eq(nan < 0.0, false);
  ts_eq(nan >= 0.0, false);
});

struct EqAlways {
  id: int;

  func op_eq(self, rhs: EqAlways): bool { return true; }
}

ts_test("std.ops operators do not change key equality", func() {
  let value = EqAlways { id: 1 };
  let other = EqAlways { id: 2 };

  ts_eq(value == other, true);
  ts_eq([value].contains(other), 0);
  ts_eq(match (value) {
    case EqAlways { id: 1 } => "one";
    default => "other";
  }, "one");
  ts_eq(match (other) {
    case EqAlways { id: 1 } => "one";
    default => "other";
  }, "other");

  let d: dict[EqAlways, int] = {};
  d[value] = 10;
  d[other] = 20;
  ts_eq(len(d), 2);
  ts_eq(d[value], 10);
  ts_eq(d[other], 20);
});

struct OpText {
  func op_add(self, rhs: OpText): string { return "text"; }
}

ts_test("std.ops overload result type", func() {
  let value = OpText {} + OpText {};
  ts_eq(value, "text");
});

enum OpChoice { Left; Right; }

impl OpChoice {
  func op_add(self, rhs: OpChoice): int { return 9; }
}

ts_test("std.ops enum overload", func() {
  let left: OpChoice = OpChoice.Left;
  let right: OpChoice = OpChoice.Right;
  ts_eq(left + right, 9);
});

ts_finish();
