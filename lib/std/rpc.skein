package rpc {
  import std;

  // Synchronous client over one process_io transport.  Connection
  // satisfies std.traits.RpcClient via call/submit, and Job satisfies
  // std.traits.RpcJob via wait.
  export struct Connection {
    _call: Callable;
    _call_bytes: Callable;
    _submit: Callable;
    _submit_bytes: Callable;
    _close: Callable;
    _reconnect: Callable;
    _pid: Callable;
    _stats: Callable;
    options: dict;
  }

  impl Connection {
    func call(self, method: string, args: list) {
      return self._call(method, args, 0);
    }

    func call_timeout(self, method: string, args: list, timeout_ms: int) {
      return self._call(method, args, timeout_ms);
    }

    func call_bytes(self, method: string, args: list, body: bytes) {
      return self._call_bytes(method, args, body, 0);
    }

    func call_bytes_timeout(self, method: string, args: list, body: bytes,
                            timeout_ms: int) {
      return self._call_bytes(method, args, body, timeout_ms);
    }

    func submit(self, method: string, args: list) {
      return self._submit(method, args);
    }

    func submit_bytes(self, method: string, args: list, body: bytes) {
      return self._submit_bytes(method, args, body);
    }

    func close(self) {
      self._close();
    }

    // Re-spawn the child process for a connection created by rpc.spawn.
    func reconnect(self) {
      return self._reconnect();
    }

    func pid(self) {
      return self._pid();
    }

    func stats(self) {
      return self._stats();
    }
  }

  // Deferred call produced by Connection.submit.  The request is sent when
  // wait is called, so a single connection keeps calls strictly ordered.
  export struct Job {
    _wait: Callable;
    _id: Callable;
    _done: Callable;
  }

  impl Job {
    func wait(self, timeout_ms: int = 0) {
      return self._wait(timeout_ms);
    }

    func id(self) {
      return self._id();
    }

    func done(self) {
      return self._done();
    }
  }

  // A pool of RpcClient objects that distributes calls round-robin.
  // Pool satisfies std.traits.RpcClient via call/submit, and PoolJob
  // satisfies std.traits.RpcJob via wait.
  export struct Pool {
    _call: Callable;
    _call_timeout: Callable;
    _call_bytes: Callable;
    _call_bytes_timeout: Callable;
    _submit: Callable;
    _submit_bytes: Callable;
    _map: Callable;
    _stats: Callable;
    _health: Callable;
    _reset: Callable;
    _close: Callable;
    clients: list;
  }

  impl Pool {
    func call(self, method: string, args: list) {
      return self._call(method, args);
    }

    func call_timeout(self, method: string, args: list, timeout_ms: int) {
      return self._call_timeout(method, args, timeout_ms);
    }

    func call_bytes(self, method: string, args: list, body: bytes) {
      return self._call_bytes(method, args, body);
    }

    func call_bytes_timeout(self, method: string, args: list, body: bytes,
                            timeout_ms: int) {
      return self._call_bytes_timeout(method, args, body, timeout_ms);
    }

    func submit(self, method: string, args: list) {
      return self._submit(method, args);
    }

    func submit_bytes(self, method: string, args: list, body: bytes) {
      return self._submit_bytes(method, args, body);
    }

    func map(self, method: string, items: list) {
      return self._map(method, items, 0);
    }

    func map_timeout(self, method: string, items: list, timeout_ms: int) {
      return self._map(method, items, timeout_ms);
    }

    func stats(self) {
      return self._stats();
    }

    // Per-client circuit breaker state.
    func health(self) {
      return self._health();
    }

    // Clear failure counts and reopen all circuits.
    func reset(self) {
      return self._reset();
    }

    func close(self) {
      return self._close();
    }
  }

  // Deferred call produced by Pool.submit.  Forwards to the underlying
  // client's job and satisfies std.traits.RpcJob via wait.
  export struct PoolJob {
    _wait: Callable;
    _id: Callable;
    _done: Callable;
  }

  impl PoolJob {
    func wait(self, timeout_ms: int = 0) {
      return self._wait(timeout_ms);
    }

    func id(self) {
      return self._id();
    }

    func done(self) {
      return self._done();
    }
  }

  // Wrap an existing process_io transport and consume its ready frame.
  export func connect(io, options = {}) {
    let protocol = std.dict.get(options, "protocol", "jsonl");
    if (protocol != "jsonl" && protocol != "hybrid") {
      std.error.fail!("rpc.connect supports protocol \"jsonl\" or \"hybrid\"");
    }
    if (std.dict.get(options, "ready", true)) {
      _handshake(
        io, options, protocol,
        std.dict.get(options, "timeout_ms", 5000));
    }
    return _connection(io, options, false, null);
  }

  func _spawn_opened(command, options, protocol) {
    let io = std.process.spawn_pipe(command, options);
    let opened = std.result.capture(func() {
      if (std.dict.get(options, "ready", true)) {
        _handshake(
          io, options, protocol,
          std.dict.get(options, "timeout_ms", 5000));
      }
    });
    if (std.result.is_err(opened)) {
      let error = std.result.error(opened);
      io.close();
      std.error.fail!(std.error.message(error));
    }
    return io;
  }

  // Spawn a child process with std.process.spawn_pipe and wrap it as an
  // owning RPC connection.  RPC options are ignored by spawn.
  export func spawn(command, options = {}) {
    let protocol = std.dict.get(options, "protocol", "jsonl");
    if (protocol != "jsonl" && protocol != "hybrid") {
      std.error.fail!("rpc.spawn supports protocol \"jsonl\" or \"hybrid\"");
    }
    let io = _spawn_opened(command, options, protocol);
    let reopen = func() {
      return _spawn_opened(command, options, protocol);
    };
    return _connection(io, options, true, reopen);
  }

  // Custom framing hook: encode a frame dict as one line (without newline).
  // Defaults to std.json.stringify.  The hook must return a string.
  func _encode_line(options, frame) {
    let encode = std.dict.get(options, "encode", null);
    if (encode == null) {
      return std.json.stringify(frame);
    }
    let encoded = encode(frame);
    if (std.type.kind_of(encoded) != "string") {
      std.error.fail!("rpc encode must return a string");
    }
    return encoded;
  }

  // Custom framing hook: decode one line into a frame dict.  Defaults to
  // std.json.parse.  The hook must return a dict.
  func _decode_line(options, line) {
    let decode = std.dict.get(options, "decode", null);
    let text = line;
    if (std.type.kind_of(text) == "bytes") {
      text = std.bytes.to_string(text);
    }
    if (decode == null) {
      return std.json.parse(text);
    }
    let frame = decode(text);
    if (std.type.kind_of(frame) != "dict") {
      std.error.fail!("rpc decode must return a dict");
    }
    return frame;
  }

  func _handshake(io, options, protocol, timeout_ms) {
    let line = io.read_line(timeout_ms);
    if (line == null) {
      std.error.fail!("rpc connection closed before ready");
    }
    let frame = _decode_line(options, line);
    if (std.dict.get(frame, "ready", false) != true) {
      std.error.fail!("rpc ready frame is invalid");
    }
    let remote = std.dict.get(frame, "protocol", "jsonl");
    if (remote != protocol) {
      std.error.fail!("rpc protocol mismatch: expected " + protocol + ", got " + remote);
    }
  }

  func _connection(io, options, owns, reopen) {
    let protocol = std.dict.get(options, "protocol", "jsonl");
    let state = {
      "protocol": protocol,
      "next_id": 1,
      "calls": 0,
      "errors": 0,
      "reconnects": 0,
      "closed": false,
      "owns": owns,
      "io": io,
      "pending": {}
    };

    // Send one request and return its id.  submit uses this eagerly so many
    // requests can be in flight before their responses are consumed.
    let send = func(method, params, body) {
      let id = state["next_id"];
      state["next_id"] = id + 1;
      _send_frame(
        state["io"], options, protocol, id, method, params, body);
      return id;
    };

    // Wait for one response id, buffering responses that belong to other
    // pending calls.
    let receive = func(id, binary, timeout_ms) {
      if (state["closed"]) {
        return std.result.err(std.error.new("rpc", "connection is closed"));
      }
      let fetched = std.result.capture(func() {
        while (true) {
          // Check on every iteration: another fiber may have buffered this
          // response while we were waiting to read.
          if (std.dict.has(state["pending"], id)) {
            let entry = state["pending"][id];
            state["pending"] = std.dict.delete(state["pending"], id);
            return entry;
          }
          let frame = _read_frame(
            state["io"], options, protocol, timeout_ms);
          let response = frame["response"];
          let response_id = std.dict.get(response, "id", 0);
          if (response_id == id) {
            return frame;
          }
          state["pending"][response_id] = frame;
        }
      });
      if (std.result.is_err(fetched)) {
        state["errors"] = state["errors"] + 1;
        let error = std.result.error(fetched);
        return std.result.err(std.error.new("rpc", std.error.message(error)));
      }
      let result = _result_from_frame(std.result.unwrap(fetched), binary);
      state["calls"] = state["calls"] + 1;
      if (std.result.is_err(result)) {
        state["errors"] = state["errors"] + 1;
      }
      return result;
    };

    let perform = func(method, params, body, binary, timeout_ms) {
      if (state["closed"]) {
        return std.result.err(std.error.new("rpc", "connection is closed"));
      }
      let sent = std.result.capture(func() {
        return send(method, params, body);
      });
      if (std.result.is_err(sent)) {
        state["errors"] = state["errors"] + 1;
        let error = std.result.error(sent);
        return std.result.err(std.error.new("rpc", std.error.message(error)));
      }
      return receive(std.result.unwrap(sent), binary, timeout_ms);
    };

    let submit_one = func(method, params, body, binary) {
      let job_state = {"id": 0, "done": false, "result": null};
      let sent = std.result.capture(func() {
        job_state["id"] = send(method, params, body);
      });
      if (std.result.is_err(sent)) {
        state["errors"] = state["errors"] + 1;
        let error = std.result.error(sent);
        job_state["result"] =
          std.result.err(std.error.new("rpc", std.error.message(error)));
        job_state["done"] = true;
      }
      return Job {
        _wait: func(timeout_ms) {
          if (job_state["done"] == false) {
            job_state["result"] = receive(
              job_state["id"], binary, timeout_ms);
            job_state["done"] = true;
          }
          return job_state["result"];
        },
        _id: func() { return job_state["id"]; },
        _done: func() {
          return job_state["done"] ||
                 std.dict.has(state["pending"], job_state["id"]);
        }
      };
    };

    let reconnect_one = func() {
      if (reopen == null) {
        return std.result.err(std.error.new(
          "rpc", "connection cannot reconnect without a spawn command"));
      }
      let opened = std.result.capture(func() {
        return reopen();
      });
      if (std.result.is_err(opened)) {
        state["errors"] = state["errors"] + 1;
        return opened;
      }
      if (state["closed"] == false) {
        std.result.capture(func() {
          state["io"].close();
        });
      }
      state["io"] = std.result.unwrap(opened);
      state["pending"] = {};
      state["closed"] = false;
      state["reconnects"] = state["reconnects"] + 1;
      return std.result.ok(true);
    };

    return Connection {
      _call: func(method, args, timeout_ms) {
        return perform(
          method, args, std.bytes.from_string(""), false, timeout_ms);
      },
      _call_bytes: func(method, args, body, timeout_ms) {
        return perform(method, args, body, true, timeout_ms);
      },
      _submit: func(method, args) {
        return submit_one(method, args, std.bytes.from_string(""), false);
      },
      _submit_bytes: func(method, args, body) {
        return submit_one(method, args, body, true);
      },
      _close: func() {
        if (state["closed"] == false) {
          state["closed"] = true;
          std.result.capture(func() {
            state["io"].close();
          });
        }
      },
      _reconnect: reconnect_one,
      _pid: func() {
        return state["io"].pid();
      },
      _stats: func() {
        return {
          "calls": state["calls"],
          "errors": state["errors"],
          "reconnects": state["reconnects"],
          "protocol": state["protocol"],
          "closed": state["closed"],
          "owns": state["owns"],
          "pending": std.utils.len(state["pending"])
        };
      },
      options: options
    };
  }

  func _send_frame(io, options, protocol, id, method, params, body) {
    let hybrid = protocol == "hybrid";
    let request = {"id": id, "method": method, "params": params};
    if (hybrid) {
      request["body_len"] = std.utils.len(body);
    }
    io.write(_encode_line(options, request) + "\n");
    if (hybrid && std.utils.len(body) > 0) {
      io.write(body);
    }
    io.flush();
  }

  func _read_frame(io, options, protocol, timeout_ms) {
    let line = io.read_line(timeout_ms);
    if (line == null) {
      std.error.fail!("rpc connection closed");
    }
    let response = _decode_line(options, line);
    let body = std.bytes.from_string("");
    if (protocol == "hybrid") {
      let body_len = std.dict.get(response, "body_len", 0);
      if (body_len > 0) {
        body = io.read_exact(body_len, timeout_ms);
      }
    }
    return {"response": response, "body": body};
  }

  func _result_from_frame(frame, binary) {
    let response = frame["response"];
    if (response["ok"] == false) {
      let error = std.dict.get(response, "error", {});
      let kind = std.dict.get(error, "kind", "rpc");
      let message = std.dict.get(error, "message", "rpc call failed");
      return std.result.err(std.error.new(kind, message));
    }
    if (binary) {
      return std.result.ok({
        "value": response["result"],
        "body": frame["body"]
      });
    }
    return std.result.ok(response["result"]);
  }

  func _has_method(value, name) {
    return std.result.is_ok(std.result.capture(func() {
      return value[name];
    }));
  }

  // Invoke a client's call method, preferring timeout-aware variants when
  // available and falling back to the base RpcClient interface.
  func _client_call(client, method, args, body, binary, timeout_ms) {
    if (binary) {
      if (timeout_ms > 0 && _has_method(client, "call_bytes_timeout")) {
        return client.call_bytes_timeout(method, args, body, timeout_ms);
      }
      return client.call_bytes(method, args, body);
    }
    if (timeout_ms > 0 && _has_method(client, "call_timeout")) {
      return client.call_timeout(method, args, timeout_ms);
    }
    return client.call(method, args);
  }

  func _client_submit(client, method, args, body, binary) {
    if (binary) {
      return client.submit_bytes(method, args, body);
    }
    return client.submit(method, args);
  }

  // Reconnect a client when it supports it.  Other clients (for example
  // worker_pool) are left untouched.
  func _client_reconnect(client) {
    if (_has_method(client, "reconnect") == false) {
      return std.result.ok(false);
    }
    if (_has_method(client, "stats")) {
      let stats = client.stats();
      if (stats["closed"] == true) {
        return std.result.ok(false);
      }
    }
    return client.reconnect();
  }

  // Create a round-robin pool over a list of RpcClient objects.
  //
  // options:
  //   failure_limit: consecutive failures before opening a circuit (0 disables)
  //   cooldown_ms:   how long an open circuit blocks a client
  export func pool(clients, options = {}) {
    if (std.utils.len(clients) == 0) {
      std.error.fail!("rpc.pool requires at least one client");
    }
    let failure_limit = std.dict.get(options, "failure_limit", 3);
    let cooldown_ms = std.dict.get(options, "cooldown_ms", 5000);
    let health = [];
    for client in clients {
      health = std.list.append(
        health, {"failures": 0, "open_until": 0});
    }
    let state = {
      "next": 0,
      "calls": 0,
      "errors": 0,
      "reconnects": 0,
      "closed": false,
      "health": health
    };

    let is_open = func(idx, now) {
      if (failure_limit <= 0) {
        return false;
      }
      let h = state["health"][idx];
      return h["failures"] >= failure_limit && now < h["open_until"];
    };

    // Pick the next available client.  Open circuits are skipped; when all
    // circuits are open the next client is used as a half-open probe.
    let pick = func() {
      if (state["closed"]) {
        std.error.fail!("rpc pool is closed");
      }
      let n = std.utils.len(clients);
      let now = std.time.monotonic_ms();
      let start = state["next"] % n;
      let i = 0;
      while (i < n) {
        let idx = (start + i) % n;
        if (is_open(idx, now) == false) {
          state["next"] = idx + 1;
          return {"client": clients[idx], "index": idx};
        }
        i = i + 1;
      }
      let idx = state["next"] % n;
      state["next"] = idx + 1;
      return {"client": clients[idx], "index": idx};
    };

    // A successful reconnect clears the circuit immediately.  Failures are
    // swallowed so they do not replace the original RPC error.
    let _try_reconnect = func(idx) {
      let captured = std.result.capture(func() {
        return _client_reconnect(clients[idx]);
      });
      if (std.result.is_err(captured)) {
        return false;
      }
      let reopened = std.result.unwrap(captured);
      if (std.type.kind_of(reopened) != "result" ||
          std.result.is_err(reopened) ||
          std.result.unwrap(reopened) != true) {
        return false;
      }
      state["reconnects"] = state["reconnects"] + 1;
      return true;
    };

    let record_health = func(idx, result) {
      if (failure_limit > 0) {
        if (std.result.is_err(result)) {
          state["health"][idx]["failures"] =
            state["health"][idx]["failures"] + 1;
          if (state["health"][idx]["failures"] >= failure_limit) {
            state["health"][idx]["open_until"] =
              std.time.monotonic_ms() + cooldown_ms;
            if (_try_reconnect(idx)) {
              state["health"][idx]["failures"] = 0;
              state["health"][idx]["open_until"] = 0;
            }
          }
        } else {
          state["health"][idx]["failures"] = 0;
          state["health"][idx]["open_until"] = 0;
        }
      }
    };

    let record = func(idx, result) {
      state["calls"] = state["calls"] + 1;
      if (std.result.is_err(result)) {
        state["errors"] = state["errors"] + 1;
      }
      record_health(idx, result);
      return result;
    };

    let call_one = func(method, args, body, binary, timeout_ms) {
      if (state["closed"]) {
        return std.result.err(std.error.new("rpc", "rpc pool is closed"));
      }
      let picked = pick();
      let result = _client_call(
        picked["client"], method, args, body, binary, timeout_ms);
      return record(picked["index"], result);
    };

    let submit_one = func(method, args, body, binary) {
      if (state["closed"]) {
        return PoolJob {
          _wait: func(timeout_ms) {
            return std.result.err(std.error.new("rpc", "rpc pool is closed"));
          },
          _id: func() { return 0; },
          _done: func() { return true; }
        };
      }
      let picked = pick();
      let underlying = _client_submit(
        picked["client"], method, args, body, binary);
      let idx = picked["index"];
      state["calls"] = state["calls"] + 1;
      return PoolJob {
        _wait: func(timeout_ms) {
          let result = underlying.wait(timeout_ms);
          if (std.result.is_err(result)) {
            state["errors"] = state["errors"] + 1;
          }
          record_health(idx, result);
          return result;
        },
        _id: func() { return underlying.id(); },
        _done: func() { return underlying.done(); }
      };
    };

    // Sequential dispatch: a single rpc.Connection has one response stream,
    // so concurrent calls on the same client are not supported.  Different
    // clients are still load-balanced round-robin.
    let map_one = func(method, items, timeout_ms) {
      let results = [];
      for item in items {
        results = std.list.append(results, call_one(
          method, [item], std.bytes.from_string(""), false, timeout_ms));
      }
      return results;
    };

    let health_snapshot = func() {
      let now = std.time.monotonic_ms();
      let out = [];
      for i in std.utils.range(std.utils.len(state["health"])) {
        let h = state["health"][i];
        out = std.list.append(out, {
          "index": i,
          "failures": h["failures"],
          "open": is_open(i, now)
        });
      }
      return out;
    };

    return Pool {
      _call: func(method, args) {
        return call_one(method, args, std.bytes.from_string(""), false, 0);
      },
      _call_timeout: func(method, args, timeout_ms) {
        return call_one(method, args, std.bytes.from_string(""),
                        false, timeout_ms);
      },
      _call_bytes: func(method, args, body) {
        return call_one(method, args, body, true, 0);
      },
      _call_bytes_timeout: func(method, args, body, timeout_ms) {
        return call_one(method, args, body, true, timeout_ms);
      },
      _submit: func(method, args) {
        return submit_one(method, args, std.bytes.from_string(""), false);
      },
      _submit_bytes: func(method, args, body) {
        return submit_one(method, args, body, true);
      },
      _map: map_one,
      _stats: func() {
        let now = std.time.monotonic_ms();
        let healthy = 0;
        for i in std.utils.range(std.utils.len(state["health"])) {
          if (is_open(i, now) == false) {
            healthy = healthy + 1;
          }
        }
        return {
          "clients": std.utils.len(clients),
          "calls": state["calls"],
          "errors": state["errors"],
          "reconnects": state["reconnects"],
          "closed": state["closed"],
          "healthy": healthy
        };
      },
      _health: health_snapshot,
      _reset: func() {
        for i in std.utils.range(std.utils.len(state["health"])) {
          state["health"][i]["failures"] = 0;
          state["health"][i]["open_until"] = 0;
        }
      },
      _close: func() {
        if (state["closed"] == false) {
          state["closed"] = true;
          for client in clients {
            std.result.capture(func() {
              return client.close();
            });
          }
        }
      },
      clients: clients
    };
  }

  // Object wrapper around the server loop.  Server satisfies the
  // std.traits.RpcServer proto via its serve(self): int method.
  export struct Server {
    _serve: Callable;
    _stats: Callable;
    options: dict;
  }

  impl Server {
    func serve(self): int {
      return self._serve();
    }

    // Snapshot of the loop counters for this server.
    func stats(self) {
      return self._stats();
    }
  }

  // Wrap a handler in an RpcServer object without running the loop yet.
  export func server(handler, options = {}) {
    let stats = {
      "served": 0,
      "errors": 0,
      "protocol": std.dict.get(options, "protocol", "jsonl")
    };
    return Server {
      _serve: func() {
        let latest = _serve(handler, options);
        stats["served"] = stats["served"] + latest["served"];
        stats["errors"] = stats["errors"] + latest["errors"];
        return latest["served"];
      },
      _stats: func() {
        return {
          "served": stats["served"],
          "errors": stats["errors"],
          "protocol": stats["protocol"]
        };
      },
      options: options
    };
  }

  // Run a handler as an RPC server loop.
  export func serve(handler, options = {}) {
    return _serve(handler, options)["served"];
  }

  // Minimal JSON Lines / hybrid RPC server loop.
  //
  // options:
  //   protocol: "jsonl" (default) or "hybrid"
  //   input:    readable stream, defaults to std.io.stdin
  //   output:   writable stream, defaults to std.io.stdout
  //   ready:    emit the ready frame, defaults to true
  //
  // jsonl:
  //   handler(method, params) -> result
  //
  // hybrid:
  //   handler(method, params, body) -> result | {value, body}
  //
  // A throwing handler is reported as an ok:false response and the loop
  // continues with the next request.
  func _serve(handler, options) {
    if (std.type.kind_of(handler) != "function" && std.type.kind_of(handler) != "builtin") {
      std.error.fail!("rpc handler must be callable");
    }
    let protocol = std.dict.get(options, "protocol", "jsonl");
    if (protocol != "jsonl" && protocol != "hybrid") {
      std.error.fail!("rpc server supports protocol \"jsonl\" or \"hybrid\"");
    }
    let hybrid = protocol == "hybrid";
    let input = std.dict.get(options, "input", std.io.stdin);
    let output = std.dict.get(options, "output", std.io.stdout);
    let send_ready = std.dict.get(options, "ready", true);

    if (send_ready) {
      let ready = {"ready": true, "version": 1};
      if (hybrid) {
        ready["protocol"] = "hybrid";
      }
      std.io.write_all(output, _encode_line(options, ready) + "\n");
      std.io.flush(output);
    }

    let served = 0;
    let errors = 0;
    while (true) {
      let line = std.io.read_line(input);
      if (line == null) {
        break;
      }
      let parsed = std.result.capture(func() {
        return _decode_line(options, line);
      });
      if (std.result.is_err(parsed)) {
        errors = errors + 1;
        break;
      }
      let request = std.result.unwrap(parsed);
      let id = std.dict.get(request, "id", null);
      let method = std.dict.get(request, "method", "");
      let params = std.dict.get(request, "params", []);

      let body = std.bytes.from_string("");
      if (hybrid) {
        let body_len = std.dict.get(request, "body_len", 0);
        if (body_len > 0) {
          body = std.io.read_exact(input, body_len);
        }
      }

      let call = std.result.capture(func() {
        if (hybrid) {
          return handler(method, params, body);
        }
        return handler(method, params);
      });

      let response = null;
      let response_body = std.bytes.from_string("");
      if (std.result.is_ok(call)) {
        let value = std.result.unwrap(call);
        response = {"id": id, "ok": true};
        if (hybrid) {
          if (std.type.kind_of(value) == "dict" && std.dict.has(value, "value")) {
            response["result"] = value["value"];
            if (std.dict.has(value, "body")) {
              response_body = value["body"];
            }
          } else {
            response["result"] = value;
          }
          response["body_len"] = std.utils.len(response_body);
        } else {
          response["result"] = value;
        }
      } else {
        let error = std.result.error(call);
        errors = errors + 1;
        response = {
          "id": id,
          "ok": false,
          "error": {
            "kind": "worker",
            "message": std.error.message(error)
          }
        };
        if (hybrid) {
          response["body_len"] = 0;
        }
      }

      std.io.write_all(output, _encode_line(options, response) + "\n");
      if (std.utils.len(response_body) > 0) {
        std.io.write_all(output, response_body);
      }
      std.io.flush(output);
      served = served + 1;
    }
    return {"served": served, "errors": errors};
  }
}
