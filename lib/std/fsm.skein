package fsm {
  import std;

  const _NIL = -1;
  const _MASK = (1 << 32) - 1;

  struct _Node {
    value: any;
    prev: int;
  }

  struct _Table {
    slots: dict;
    gens: dict;
    free: any;
    alive: int;
  }

  struct _AddResult {
    table: _Table;
    id: int;
  }

  export struct Machine {
    _initial: any;
    _step: Callable;
    _on_transition: any;
    _kind: string;
    _name: string;
    _package_name: string;
  }

  export struct Context {
    state: any;
    _history: any;
    _head: int;
    _redo: list;
  }

  // MachineApi is the public structural contract for Machine operations.
  // Context history operations remain package-level functions.
  proto MachineApi {
    func initial(self);
    func start(self);
    func step(self, ctx: Context, event: any);
    func run(self, ctx: Context, events: any);
  }

  func _t_new() {
    return _Table {
      slots: {},
      gens: {},
      free: std.deque.new(),
      alive: 0
    };
  }

  func _t_add(t, value, prev) {
    let slot = _NIL;

    if (std.deque.size(t.free) > 0) {
      let popped = std.deque.pop_back(t.free);
      slot = popped["value"];
      t.free = popped["deque"];
      t.gens[slot] = t.gens[slot] + 1;
      t.slots[slot] = _Node { value: value, prev: prev };
    } else {
      slot = std.utils.len(t.slots);
      t.slots[slot] = _Node { value: value, prev: prev };
      t.gens[slot] = 0;
    }

    t.alive = t.alive + 1;
    return _AddResult { table: t, id: (t.gens[slot] << 32) | slot };
  }

  func _t_node(t, id) {
    let slot = id & _MASK;
    let gen = id >> 32;

    if (slot < 0 || slot >= std.utils.len(t.slots)) {
      fail("stale fsm history handle");
    }
    if (t.gens[slot] != gen) {
      fail("stale fsm history handle");
    }
    let node = t.slots[slot];
    if (node == null) {
      fail("stale fsm history handle");
    }
    return node;
  }

  func _t_valid(t, id) {
    let slot = id & _MASK;
    let gen = id >> 32;

    if (slot < 0 || slot >= std.utils.len(t.slots)) {
      return false;
    }
    if (t.gens[slot] != gen) {
      return false;
    }
    return t.slots[slot] != null;
  }

  func _t_remove(t, id) {
    let slot = id & _MASK;
    let gen = id >> 32;

    if (slot < 0 || slot >= std.utils.len(t.slots)) {
      fail("stale fsm history handle");
    }
    if (t.gens[slot] != gen || t.slots[slot] == null) {
      fail("stale fsm history handle");
    }

    t.slots[slot] = null;
    t.gens[slot] = t.gens[slot] + 1;
    t.free = std.deque.push_back(t.free, slot);
    t.alive = t.alive - 1;
    return t;
  }

  func _t_check(t) {
    if (std.utils.len(t.slots) != std.utils.len(t.gens)) {
      return false;
    }
    if (t.alive < 0 || t.alive > std.utils.len(t.slots)) {
      return false;
    }
    for (let i in std.utils.range(std.utils.len(t.slots))) {
      if (t.slots[i] != null && std.type.kind_of(t.slots[i]) != "struct") {
        return false;
      }
    }
    return true;
  }

  func _decode_state(value, decode) {
    if (std.type.kind_of(value) != "dict") {
      return value;
    }
    if (decode != null) {
      return decode(value);
    }
    if (std.dict.has(value, "$enum")) {
      return std.enum.decode(value);
    }
    return value;
  }

  func _t_to_value(t) {
    let slots = std.deque.new();
    let gens = std.deque.new();
    let i = 0;
    while (i < std.utils.len(t.slots)) {
      let node = t.slots[i];
      if (node == null) {
        slots = std.deque.push_back(slots, null);
      } else {
        slots = std.deque.push_back(slots, {
          "value": node.value,
          "prev": node.prev
        });
      }
      gens = std.deque.push_back(gens, t.gens[i]);
      i = i + 1;
    }

    return {
      "slots": std.deque.to_list(slots),
      "gens": std.deque.to_list(gens),
      "free": std.deque.to_list(t.free),
      "alive": t.alive
    };
  }

  func _t_from_value(v, decode) {
    let source_slots = v["slots"];
    let source_gens = v["gens"];
    let slots = {};
    let gens = {};
    let i = 0;
    while (i < std.utils.len(source_slots)) {
      let item = source_slots[i];
      if (item == null) {
        slots[i] = null;
      } else {
        slots[i] = _Node {
          value: _decode_state(item["value"], decode),
          prev: item["prev"]
        };
      }
      gens[i] = source_gens[i];
      i = i + 1;
    }

    return _Table {
      slots: slots,
      gens: gens,
      free: std.deque.from_list(v["free"]),
      alive: v["alive"]
    };
  }

  export func define(initial, step, on_transition = null) {
    if (std.type.kind_of(step) != "function" && std.type.kind_of(step) != "builtin") {
      fail("step must be callable");
    }

    if (on_transition != null &&
        std.type.kind_of(on_transition) != "function" &&
        std.type.kind_of(on_transition) != "builtin") {
      fail("on_transition must be callable");
    }

    return Machine {
      _initial: initial,
      _step: step as Callable,
      _on_transition: on_transition as Callable,
      _kind: std.type.kind_of(initial),
      _name: std.type.name(initial),
      _package_name: std.type.package_name(initial)
    };
  }

  impl Machine {
    func initial(self) {
      return self._initial;
    }

    func start(self) {
      let r = _t_add(_t_new(), self._initial, _NIL);
      return Context {
        state: self._initial,
        _history: r.table,
        _head: r.id,
        _redo: []
      };
    }

    func step(self, ctx: Context, event: any) {
      let next = self._step(ctx.state, event);

      if (self._kind == "enum" || self._kind == "struct") {
        if (std.type.kind_of(next) != self._kind ||
            std.type.name(next) != self._name ||
            std.type.package_name(next) != self._package_name) {
          fail("step must return " + self._name + ", got " +
               std.type.kind_of(next) + " " + std.type.name(next));
        }
      }

      if (self._on_transition != null) {
        self._on_transition(ctx.state, event, next);
      }

      let r = _t_add(ctx._history, next, ctx._head);
      return Context {
        state: next,
        _history: r.table,
        _head: r.id,
        _redo: []
      };
    }

    func run(self, ctx: Context, events: any) {
      for (let event in events) {
        let next = self._step(ctx.state, event);

        if (self._kind == "enum" || self._kind == "struct") {
          if (std.type.kind_of(next) != self._kind ||
              std.type.name(next) != self._name ||
              std.type.package_name(next) != self._package_name) {
            fail("step must return " + self._name + ", got " +
                 std.type.kind_of(next) + " " + std.type.name(next));
          }
        }

        if (self._on_transition != null) {
          self._on_transition(ctx.state, event, next);
        }

        // Inline _t_add: after the first COW fork inside this call, the history
        // table is uniquely owned and every following event is O(1).
        let slot = _NIL;
        if (std.deque.size(ctx._history.free) > 0) {
          let popped = std.deque.pop_back(ctx._history.free);
          slot = popped["value"];
          ctx._history.free = popped["deque"];
          ctx._history.gens[slot] = ctx._history.gens[slot] + 1;
          ctx._history.slots[slot] = _Node { value: next, prev: ctx._head };
        } else {
          slot = std.utils.len(ctx._history.slots);
          ctx._history.slots[slot] = _Node { value: next, prev: ctx._head };
          ctx._history.gens[slot] = 0;
        }
        ctx._history.alive = ctx._history.alive + 1;

        ctx.state = next;
        ctx._head = (ctx._history.gens[slot] << 32) | slot;
        ctx._redo = [];
      }
      return ctx;
    }
  }

  export func history(ctx) {
    let out = std.deque.new();
    let id = ctx._head;

    while (id != _NIL) {
      let node = _t_node(ctx._history, id);
      out = std.deque.push_front(out, node.value);
      id = node.prev;
    }

    return std.deque.to_list(out);
  }

  export func undo(ctx) {
    let node = _t_node(ctx._history, ctx._head);
    if (node.prev == _NIL) {
      return ctx;
    }

    let redo = std.list.append(ctx._redo, ctx._head);
    let prev = _t_node(ctx._history, node.prev);
    return Context {
      state: prev.value,
      _history: ctx._history,
      _head: node.prev,
      _redo: redo
    };
  }

  export func redo(ctx) {
    let n = std.utils.len(ctx._redo);
    if (n == 0) {
      return ctx;
    }

    let id = ctx._redo[n - 1];
    let redo = std.list.slice(ctx._redo, 0, n - 1);
    let node = _t_node(ctx._history, id);
    return Context {
      state: node.value,
      _history: ctx._history,
      _head: id,
      _redo: redo
    };
  }

  export func snapshot(ctx) {
    return {
      "state": ctx.state,
      "history": _t_to_value(ctx._history),
      "head": ctx._head,
      "redo": ctx._redo
    };
  }

  export func restore(snap, decode = null) {
    let history = _t_from_value(snap["history"], decode);
    if (!_t_check(history)) {
      fail("invalid fsm snapshot");
    }
    return Context {
      state: _decode_state(snap["state"], decode),
      _history: history,
      _head: snap["head"],
      _redo: snap["redo"]
    };
  }
}
