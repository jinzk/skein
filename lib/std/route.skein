package route {
  import std;

  const _STATIC = 0;
  const _PARAM = 1;
  const _WILD = 2;
  const _MAX_SEGMENTS = 32;

  export struct Router {
    add: callable;
    get: callable;
    post: callable;
    put: callable;
    delete: callable;
    use: callable;
    use_after: callable;
    dispatch: callable;
    inspect: callable;
  }

  // Trie nodes are long-lived mutable state shared by every copy of a Router.
  // A ref keeps parameter/wildcard traversal and handler selection on direct
  // field access.  The static-child table has a fast dict snapshot for reads
  // and a small mutator closure for writes; dropping the snapshot before an
  // insert avoids COW-copying a table that grows to thousands of entries.
  struct _Node {
    kids: any;
    kids_ops: callable;
    param: ref _Node? = null;
    pname: string = "";
    wild: ref _Node? = null;
    wname: string = "";
    handlers: dict;
  }

  func _node_new() {
    let kids = {};
    let ops = func(op, key, child = null) {
      if (op == 0) {
        kids[key] = child;
        return null;
      }
      return kids;
    };
    return ref _Node { kids: {}, kids_ops: ops, handlers: {} };
  }

  func _node_set_child(node, key, child) {
    node.kids = null;
    node.kids_ops(0, key, child);
    node.kids = node.kids_ops(1, null);
  }

  // std.dict.get duplicates the default value and goes through a builtin;
  // this local lookup is measurably cheaper on the dispatch hot path.
  func _dict_get(table, key) {
    if (std.dict.has(table, key)) {
      return table[key];
    }
    return null;
  }

  func _node_set_handler(node, method, handler) {
    let handlers = node.handlers;
    handlers[method] = handler;
    node.handlers = handlers;
  }

  func _parse_pattern(pattern) {
    if (kind_of(pattern) != "string") {
      fail("route pattern must be a string");
    }

    let segs = [];
    let seen_wild = false;
    for (let part in std.string.split(pattern, "/")) {
      if (part == "") {
        continue;
      }
      if (seen_wild) {
        fail("route wildcard must be the last segment");
      }
      if (std.string.starts_with(part, ":")) {
        let name = std.string.substr(part, 1);
        if (name == "") {
          fail("route parameter name is required");
        }
        segs = std.list.append(segs, [_PARAM, name]);
      } else if (std.string.starts_with(part, "*")) {
        segs = std.list.append(segs, [_WILD, std.string.substr(part, 1)]);
        seen_wild = true;
      } else {
        segs = std.list.append(segs, [_STATIC, part]);
      }
    }

    if (len(segs) > _MAX_SEGMENTS) {
      fail("route pattern is too deep");
    }
    return segs;
  }

  func _static_key(pattern, segs) {
    let parts = [];
    for (let seg in segs) {
      if (seg[0] != _STATIC) {
        return null;
      }
      parts = std.list.append(parts, seg[1]);
    }
    let canonical = "/" + std.string.join(parts, "/");
    if (canonical == pattern) {
      return pattern;
    }
    return null;
  }

  func _check_route(node, segs, i, method, pattern) {
    if (i >= len(segs)) {
      if (std.dict.has(node.handlers, method)) {
        fail("duplicate route " + method + " " + pattern);
      }
      return;
    }

    let seg = segs[i];
    let kind = seg[0];

    if (kind == _WILD) {
      let child = node.wild;
      if (child == null) {
        return;
      }
      let existing = node.wname;
      if (existing != seg[1]) {
        fail("conflicting route wildcard name: *" + existing + " vs *" + seg[1]);
      }
      _check_route(child, segs, i + 1, method, pattern);
      return;
    }

    if (kind == _PARAM) {
      let child = node.param;
      if (child == null) {
        return;
      }
      let existing = node.pname;
      if (existing != seg[1]) {
        fail("conflicting route parameter name: :" + existing + " vs :" + seg[1]);
      }
      _check_route(child, segs, i + 1, method, pattern);
      return;
    }

    let child = _dict_get(node.kids, seg[1]);
    if (child == null) {
      return;
    }
    _check_route(child, segs, i + 1, method, pattern);
  }

  func _insert_route(node, segs, i, method, handler) {
    if (i >= len(segs)) {
      _node_set_handler(node, method, handler);
      return;
    }

    let seg = segs[i];
    let kind = seg[0];

    if (kind == _WILD) {
      let child = node.wild;
      if (child == null) {
        child = _node_new();
        node.wild = child;
        node.wname = seg[1];
      }
      _insert_route(child, segs, i + 1, method, handler);
      return;
    }

    if (kind == _PARAM) {
      let child = node.param;
      if (child == null) {
        child = _node_new();
        node.param = child;
        node.pname = seg[1];
      }
      _insert_route(child, segs, i + 1, method, handler);
      return;
    }

    let child = _dict_get(node.kids, seg[1]);
    if (child == null) {
      child = _node_new();
      _node_set_child(node, seg[1], child);
    }
    _insert_route(child, segs, i + 1, method, handler);
  }

  func _split_path(path) {
    let out = std.deque.new();
    for (let part in std.string.split(path, "/")) {
      if (part != "") {
        out = std.deque.push_back(out, part);
      }
    }
    return std.deque.to_list(out);
  }

  func _walk(node, parts, si, method, params) {
    if (si >= len(parts)) {
      if (std.dict.has(node.handlers, method) ||
          std.dict.has(node.handlers, "*")) {
        return {"ok": true, "node": node, "params": params};
      }

      // A trailing wildcard also matches zero segments.
      let wild = node.wild;
      if (wild != null && (std.dict.has(wild.handlers, method) ||
                           std.dict.has(wild.handlers, "*"))) {
        let name = node.wname;
        if (name != "") {
          let next = params;
          next[name] = "";
          return {"ok": true, "node": wild, "params": next};
        }
        return {"ok": true, "node": wild, "params": params};
      }
      return {"ok": false};
    }

    let seg = parts[si];

    let child = _dict_get(node.kids, seg);
    if (child != null) {
      let found = _walk(child, parts, si + 1, method, params);
      if (found["ok"]) {
        return found;
      }
    }

    let param = node.param;
    if (param != null) {
      let next = params;
      next[node.pname] = seg;
      let found = _walk(param, parts, si + 1, method, next);
      if (found["ok"]) {
        return found;
      }
    }

    let wild = node.wild;
    if (wild != null) {
      let name = node.wname;
      let next = params;
      if (name != "") {
        next[name] = std.string.join(std.list.slice(parts, si), "/");
      }
      if (std.dict.has(wild.handlers, method) ||
          std.dict.has(wild.handlers, "*")) {
        return {"ok": true, "node": wild, "params": next};
      }
    }

    return {"ok": false};
  }

  func _walk_any(node, parts, si) {
    if (si >= len(parts)) {
      if (len(node.handlers) > 0) {
        return true;
      }
      let wild = node.wild;
      if (wild != null && len(wild.handlers) > 0) {
        return true;
      }
      return false;
    }

    let seg = parts[si];

    let child = _dict_get(node.kids, seg);
    if (child != null && _walk_any(child, parts, si + 1)) {
      return true;
    }

    let param = node.param;
    if (param != null && _walk_any(param, parts, si + 1)) {
      return true;
    }

    let wild = node.wild;
    if (wild != null && len(wild.handlers) > 0) {
      return true;
    }

    return false;
  }

  func _response(status, body) {
    return {
      "status": status,
      "headers": { "Content-Type": "text/plain" },
      "body": body
    };
  }

  func _validate_request(req) {
    if (kind_of(req) != "dict") {
      fail("route.dispatch expects a request dict");
    }
    if (!std.dict.has(req, "method") || kind_of(req["method"]) != "string") {
      fail("route.dispatch requires a string method");
    }
    if (!std.dict.has(req, "path") || kind_of(req["path"]) != "string") {
      fail("route.dispatch requires a string path");
    }
  }

  export func new() {
    let root = _node_new();
    let exact = {};
    let middlewares = [];
    let afterware = [];
    let entries = std.deque.new();

    let add = func(method, pattern, handler) {
      if (kind_of(method) != "string") {
        fail("route method must be a string");
      }
      if (kind_of(handler) != "function" && kind_of(handler) != "builtin") {
        fail("route handler must be callable");
      }

      let segs = _parse_pattern(pattern);
      _check_route(root, segs, 0, method, pattern);
      _insert_route(root, segs, 0, method, handler);

      let key = _static_key(pattern, segs);
      if (key != null) {
        let table = _dict_get(exact, key);
        if (table == null) {
          table = {};
        }
        table[method] = handler;
        exact[key] = table;
      }

      entries = std.deque.push_back(entries, {
        "method": method,
        "pattern": pattern,
        "handler": handler
      });
    };

    let route_request = func(req) {
      let method = req["method"];
      let path = req["path"];

      let table = _dict_get(exact, path);
      if (table != null) {
        let handler = _dict_get(table, method);
        if (handler == null) {
          handler = _dict_get(table, "*");
        }
        if (handler != null) {
          req["params"] = {};
          return handler(req);
        }
      }

      let parts = _split_path(path);
      let found = _walk(root, parts, 0, method, {});
      if (found["ok"]) {
        let handlers = found["node"].handlers;
        let handler = _dict_get(handlers, method);
        if (handler == null) {
          handler = _dict_get(handlers, "*");
        }
        req["params"] = found["params"];
        return handler(req);
      }

      if (table != null || _walk_any(root, parts, 0)) {
        return _response(405, "method not allowed");
      }
      return _response(404, "not found");
    };

    let apply_after = func(req, response) {
      let i = 0;
      while (i < len(afterware)) {
        let value = afterware[i](req, response);
        if (type_name(value) == "task") {
          value = value.wait();
        }
        if (value != null) {
          response = value;
        }
        i = i + 1;
      }
      return response;
    };

    let resume_after = func(req, pending) {
      let response = pending.wait();
      return apply_after(req, response);
    };

    let resume = func(req, index, pending) {
      let result = pending.wait();
      if (result != null) {
        return apply_after(req, result);
      }

      let i = index;
      while (i < len(middlewares)) {
        let value = middlewares[i](req);
        if (type_name(value) == "task") {
          value = value.wait();
        }
        if (value != null) {
          return apply_after(req, value);
        }
        i = i + 1;
      }

      let response = route_request(req);
      if (type_name(response) == "task") {
        return resume_after(req, response);
      }
      return apply_after(req, response);
    };

    let dispatch = func(req) {
      _validate_request(req);

      let i = 0;
      while (i < len(middlewares)) {
        let value = middlewares[i](req);
        if (type_name(value) == "task") {
          return resume(req, i + 1, value);
        }
        if (value != null) {
          return apply_after(req, value);
        }
        i = i + 1;
      }
      let response = route_request(req);
      if (type_name(response) == "task") {
        return resume_after(req, response);
      }
      return apply_after(req, response);
    };

    let use = func(middleware) {
      if (kind_of(middleware) != "function" &&
          kind_of(middleware) != "builtin") {
        fail("route middleware must be callable");
      }
      middlewares = std.list.append(middlewares, middleware);
    };

    let use_after = func(middleware) {
      if (kind_of(middleware) != "function" &&
          kind_of(middleware) != "builtin") {
        fail("route after middleware must be callable");
      }
      afterware = std.list.append(afterware, middleware);
    };

    let inspect = func() {
      return std.deque.to_list(entries);
    };

    return Router {
      add: add,
      get: func(pattern, handler) { add("GET", pattern, handler); },
      post: func(pattern, handler) { add("POST", pattern, handler); },
      put: func(pattern, handler) { add("PUT", pattern, handler); },
      delete: func(pattern, handler) { add("DELETE", pattern, handler); },
      use: use,
      use_after: use_after,
      dispatch: dispatch,
      inspect: inspect
    };
  }
}
