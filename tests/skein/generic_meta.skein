import std;
import std.meta;
include "_support.skein";

struct Box[T = any] {
  value: T;
}

enum Option[T = any] {
  None;
  Some { value: T; }
}

ts_test("generic meta struct", func() {
  let info = std.meta.generic_info("Box[int]");
  ts_eq(info["kind"], "struct");
  ts_eq(info["name"], "Box");
  ts_eq(info["params"], ["T"]);
  ts_eq(info["args"], ["int"]);
  ts_eq(info["instantiated"], true);
  ts_eq(info["defaulted"], false);
});

ts_test("generic meta enum", func() {
  let info = std.meta.generic_info("Option[string]");
  ts_eq(info["kind"], "enum");
  ts_eq(info["name"], "Option");
  ts_eq(info["args"], ["string"]);
  ts_eq(std.meta.type_args("Option[string]"), ["string"]);
});

ts_test("generic meta defaults", func() {
  let info = std.meta.generic_info("Box");
  ts_eq(info["args"], ["any"]);
  ts_eq(info["instantiated"], true);
  ts_eq(info["defaulted"], true);
  ts_eq(std.meta.type_args("Box"), ["any"]);
});

ts_test("generic meta non-generic", func() {
  ts_eq(std.meta.type_params("int"), []);
  ts_eq(std.meta.type_args("int"), []);
  ts_eq(std.meta.generic_info("int")["kind"], "builtin");
});

ts_test("generic meta value has no runtime args", func() {
  let b: Box[int] = Box { value: 1 };
  ts_eq(std.meta.type_args(b), null);
  ts_eq(std.meta.type_params(b), ["T"]);
});

ts_test("builtin container generic meta", func() {
  ts_eq(std.meta.type_params("list"), ["T"]);
  ts_eq(std.meta.type_args("list[int]"), ["int"]);
  ts_eq(std.meta.type_args("dict[string, list[int]]"),
        ["string", "list[int]"]);
  ts_eq(std.meta.type_args("list"), null);

  let gi = std.meta.generic_info("list[int]");
  ts_eq(gi["kind"], "builtin");
  ts_eq(gi["name"], "list");
  ts_eq(gi["params"], ["T"]);
  ts_eq(gi["args"], ["int"]);
  ts_eq(gi["instantiated"], true);
  ts_eq(gi["variadic"], false);
});

ts_test("builtin variadic generic meta", func() {
  ts_eq(std.meta.type_args("tuple[int, string]"), ["int", "string"]);
  ts_eq(std.meta.type_args("union[int, string]"), ["int", "string"]);
  ts_eq(std.meta.generic_info("tuple[int]")["variadic"], true);
});

ts_test("builtin generator default argument", func() {
  let gi = std.meta.generic_info("generator[int]");
  ts_eq(gi["params"], ["T", "S"]);
  ts_eq(gi["args"], ["int", "any"]);
  ts_eq(gi["defaulted"], true);
  ts_eq(gi["instantiated"], true);
  ts_eq(std.meta.type_args("generator[int]"), ["int", "any"]);
});

ts_test("meta type_info accepts descriptors", func() {
  ts_eq(std.meta.type_info("list[int]")["name"], "list");
  ts_eq(std.meta.type_info("Box[int]")["name"], "Box");
  ts_eq(std.meta.type_params([1, 2]), ["T"]);
  ts_eq(std.meta.type_params({"a": 1}), ["K", "V"]);
});

ts_finish();
