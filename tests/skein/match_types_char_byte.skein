import std;
include "_support.skein";

struct CharStructC {
  ch: char;
}

enum CharEnumE {
  A { ch: char; }
}

struct ByteStructS {
  b: byte;
  c: char;
}

ts_test("char literal", func() {
  let c = 'a';
  ts_eq(str(c), "a");
  ts_eq(kind_of(c), "char");
  ts_eq(type_name(c), "char");
  ts_eq(len(c), 1);
});

ts_test("char conversions", func() {
  ts_eq(int('A'), 65);
  ts_eq(str('你'), "你");
  ts_eq(str(char(65)), "A");
  ts_eq(str(char("你")), "你");
});

ts_test("char unicode escape", func() {
  ts_eq(str('\u{1F600}'), "😀");
  ts_eq(str('\u0041'), "A");
});

ts_test("char escapes", func() {
  ts_true('\n' == char(10));
  ts_eq(str('\''), "'");
  ts_eq(str('\\'), "\\");
});

ts_test("char compare", func() {
  ts_true('a' < 'b');
  ts_true('a' == 'a');
  ts_true('b' > 'a');
});

ts_test("char concat", func() {
  ts_eq('a' + "bc", "abc");
  ts_eq("x" + 'y', "xy");
  ts_eq('a' + 'b', "ab");
});

ts_test("string index char", func() {
  let s = "你好";
  ts_eq(str(s[0]), "你");
  ts_eq(kind_of(s[0]), "char");
  ts_eq(str(s[1]), "好");
});

ts_test("string iteration char", func() {
  let out = "";
  for (let ch in "ab") {
    out = out + ch;
  }
  ts_eq(out, "ab");
});

ts_test("char match", func() {
  ts_eq(match ('a') {
    case 'a' => "a";
    default => "no";
  }, "a");
});

ts_test("char switch", func() {
  let out = "";
  switch ('b') {
    case 'a' => out = "a";
    case 'b' => out = "b";
  }
  ts_eq(out, "b");
});

ts_test("char type annotation", func() {
  let c: char = 'z';
  ts_eq(str(c), "z");
  let n: char? = null;
  ts_eq(n, null);
});

ts_test("char struct json", func() {
  let j = std.json.stringify(CharStructC { ch: 'a' });
  ts_eq(j, "{\"ch\":\"a\"}");
  let c = std.struct.decode(std.json.parse(j), "CharStructC");
  ts_eq(str(c.ch), "a");
  ts_eq(kind_of(c.ch), "char");
});

ts_test("char enum json", func() {
  let e = std.enum.decode(std.json.parse(
    std.json.stringify(CharEnumE.A { ch: '你' })));
  ts_eq(str(e), "CharEnumE.A { ch: 你 }");
  ts_eq(kind_of(e.ch), "char");
});

ts_test("char sort", func() {
  ts_eq(std.list.sort(['c', 'a', 'b']), ['a', 'b', 'c']);
  ts_eq(std.list.sort_desc(['c', 'a', 'b']), ['c', 'b', 'a']);
  ts_true(std.list.is_sorted(['a', 'b', 'c']));
});

ts_test("char dict key", func() {
  let d = {'a': 1};
  ts_eq(d['a'], 1);
  ts_eq(d[char(97)], 1);
});

ts_test("byte dict key", func() {
  let d = {byte(65): 1};
  ts_eq(d[byte(65)], 1);
});

ts_test("char byte switch", func() {
  let out = [];
  switch ('a') {
    case 'a' => out = std.list.append(out, "char");
    default => out = std.list.append(out, "no");
  }
  switch (byte(65)) {
    case byte(65) => out = std.list.append(out, "byte");
    default => out = std.list.append(out, "no");
  }
  ts_eq(out, ["char", "byte"]);
});

ts_test("char bytes roundtrip", func() {
  ts_eq(std.bytes.hex(std.bytes.from_char('你')), "e4bda0");
  ts_eq(str(std.bytes.to_char(std.bytes.from_char('你'))), "你");
  ts_eq(str(char(std.bytes.from_char('a'))), "a");
});

ts_test("byte int conversions", func() {
  ts_eq(int(byte(65)), 65);
  ts_eq(int(byte(255)), 255);
  ts_eq(kind_of(byte(1)), "byte");
  ts_eq(len(byte(1)), 1);
});

ts_test("byte type annotation", func() {
  let b: byte = byte(1);
  ts_eq(int(b), 1);
  let n: byte? = null;
  ts_eq(n, null);
});

ts_test("byte struct json", func() {
  let j = std.json.stringify(ByteStructS { b: byte(255), c: 'a' });
  ts_eq(j, "{\"b\":255,\"c\":\"a\"}");
  let s = std.struct.decode(std.json.parse(j), "ByteStructS");
  ts_eq(int(s.b), 255);
  ts_eq(kind_of(s.b), "byte");
  ts_eq(str(s.c), "a");
});

ts_test("byte sort", func() {
  let xs = std.list.sort([byte(3), byte(1), byte(2)]);
  ts_eq(std.list.map(xs, func(x) { return int(x); }), [1, 2, 3]);
});

ts_finish();
