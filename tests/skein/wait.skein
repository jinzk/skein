import std;
include "_support.skein";

let wait_void_done = false;

func wait_work(n) {
  return n + 1;
}

func wait_void_work() {
  wait_void_done = true;
}

func wait_outer() {
  let t = launch wait_work(9);
  return wait t;
}

ts_test("wait variable", func() {
  let t = launch wait_work(41);
  ts_eq(wait t, 42);
});

ts_test("wait launch", func() {
  ts_eq(wait launch wait_work(1), 2);
});

ts_test("wait parenthesized launch", func() {
  ts_eq(wait (launch wait_work(2)), 3);
});

ts_test("wait binds tighter than addition", func() {
  let t = launch wait_work(3);
  ts_eq(wait t + 1, 5);
});

ts_test("wait nested task", func() {
  ts_eq(wait launch wait_outer(), 10);
});

ts_test("wait void task", func() {
  wait launch wait_void_work();
  ts_true(wait_void_done);
});

ts_test("explicit task wait still works", func() {
  let t = launch wait_work(5);
  ts_eq(t.wait(), 6);
  ts_eq(std.task.wait(t), 6);
});

ts_finish();
